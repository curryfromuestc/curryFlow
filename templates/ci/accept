#!/usr/bin/env python3
"""分阶段验收。每阶段退出码 0 通过、77 跳过、其余失败；最后一行是一行结论。

  ci/accept                    按顺序跑全部阶段
  ci/accept --stage NAME       只跑一个阶段（executor 在固定核的槽位里这样调）
  ci/accept --list [--json]    列出阶段、槽位类和判据
  ci/accept --plan PATH...     按改动的文件给出要跑的阶段（按风险分级）

派生物只准写在 .build/ 下：每个阶段跑前跑后各扫一遍工作区，.build/ 以外多了或改了文件就判这个阶段失败。
阶段拿到的环境变量：OUT=.build/accept/<阶段>（报告放这里，小的 *.txt/*.json 会随结论推到中枢），
CF_CACHE_<名字>=共享缓存目录（executor 准备好；本地跑时没有，阶段自己现建到 .build/ 下）。
--list 和 --plan 不读工作区：协调器用 `git show <候选>:ci/accept | python3 - --list` 调它。
"""
import json
import os
import subprocess
import sys
import time
from fnmatch import fnmatch

# ---- 项目填写 -----------------------------------------------------------------------------------------
# name：阶段名；class：槽位类（sim / synth / gpu / build）；cmd：在仓库根目录用 bash 跑；
# why：判据，写清通过意味着什么、用例来自哪个真实 bug；cache：{名字: {inputs: [路径], tool: 取工具版本的命令,
# build: 往 $CF_CACHE_OUT 里建的命令}}，键 = 输入的 git tree hash + 工具版本。
STAGES = [
    {"name": "lint", "class": "build", "cmd": "true", "why": "替换成项目的快速检查"},
]
# 按风险分级：每个改动的文件取第一条匹配的规则，要跑的阶段取并集。
TIERS = [
    (["**"], ["lint"]),
]
# -------------------------------------------------------------------------------------------------------

SKIP = 77


def plan(paths):
    want = set()
    for p in paths or ["**"]:
        for globs, stages in TIERS:
            if any(fnmatch(p, g) for g in globs):
                want.update(stages)
                break
    return [s["name"] for s in STAGES if s["name"] in want]


def snapshot(root):
    """{path: (size, mtime)} of the work tree outside .git/ and .build/."""
    out = {}
    for d, dirs, files in os.walk(root):
        if d == root:
            dirs[:] = [x for x in dirs if x not in (".git", ".build")]
        for f in files:
            p = os.path.join(d, f)
            try:
                st = os.lstat(p)
            except FileNotFoundError:
                continue
            out[os.path.relpath(p, root)] = (st.st_size, st.st_mtime_ns)
    return out


def run(stage, root):
    out = os.path.join(root, ".build", "accept", stage["name"])
    os.makedirs(out, exist_ok=True)
    log = os.path.join(root, ".build", "accept", stage["name"] + ".log")
    before = snapshot(root)
    t0 = time.time()
    with open(log, "w") as f:
        rc = subprocess.run(["bash", "-c", stage["cmd"]], cwd=root, stdout=f, stderr=subprocess.STDOUT,
                            env={**os.environ, "OUT": out}).returncode
    secs = time.time() - t0
    after = snapshot(root)
    stray = sorted(p for p in after if before.get(p) != after[p])
    verdict = "PASS" if rc == 0 else "SKIP" if rc == SKIP else "FAIL"
    note = ""
    if stray:
        verdict, note = "FAIL", f"写到了 .build/ 以外：{', '.join(stray[:5])}"
    elif verdict == "FAIL":
        tail = open(log, errors="replace").read().strip().splitlines()[-1:] or [""]
        note = f"rc={rc}，日志末行：{tail[0][:200]}"
    line = f"{verdict} {stage['name']} {secs:.1f}s" + (f" {note}" if note else "")
    print(line, flush=True)
    return verdict, line


def main(argv):
    if "--list" in argv:
        if "--json" in argv:
            print(json.dumps(STAGES, ensure_ascii=False))
        else:
            for s in STAGES:
                print(f"{s['name']:<10}{s['class']:<7}{s['why']}")
        return 0
    if "--plan" in argv:
        print(" ".join(plan(argv[argv.index("--plan") + 1:])))
        return 0
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    names = [argv[argv.index("--stage") + 1]] if "--stage" in argv else [s["name"] for s in STAGES]
    todo = [s for s in STAGES if s["name"] in names]
    if len(todo) != len(names):
        print(f"accept: 没有阶段 {names}", file=sys.stderr)
        return 2
    res = [(s["name"], run(s, root)[0]) for s in todo]
    bad = [n for n, v in res if v == "FAIL"]
    summary = ", ".join(f"{n} {v}" for n, v in res)
    print(f"accept: {'FAIL' if bad else 'PASS'} ({summary})")
    if len(todo) == 1:
        return {"PASS": 0, "SKIP": SKIP}.get(res[0][1], 1)
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
