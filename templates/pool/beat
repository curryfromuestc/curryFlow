#!/usr/bin/env python3
"""One heartbeat of this machine, pushed to the hub as refs/hb/<machine> (a JSON blob), or --probe to inspect a host.

usage: beat --machine NAME [--print]
       beat --probe

Run every minute by cron from a clone of the pool repository. machines.json names the machine's slots and the
mounts to report; everything else is read from the machine: busy threads per NUMA node and per slot, memory,
disks, GPUs, incus containers, who uses the CPUs, and from the machine's executor (its state.json): the job or
hold in each slot, whether the executor would schedule the slot, and the ids of every request the executor holds
(flow and the other executors take a run as alive while its machine's heartbeat moves and lists it). Every ten minutes
it pulls the clone; the heartbeat carries the clone's commit and how the last pull went (pull: ok, error, at).

Every ten minutes it also brings this machine's main directory of each project (machines.json:
projects.<project>.home.<machine>, the clone people read, e.g. ~/code/<project>) to the main of the project's hub. It
fetches that branch as refs/remotes/hub/main and fast-forwards the local main: with the work tree when main is checked
out there (git refuses when a local change is in the way), the branch alone otherwise. It never switches the branch,
merges or rewinds: a main with commits of its own stays as it is. The heartbeat says what it found (homes: branch,
main, behind, ahead, at, error), so a directory that falls behind shows on the machines page. Submodules are not
updated.

Before its first git call it removes the zero-length loose objects of the clone (.git/objects/xx/<38 hex>): what an
unclean shutdown leaves of the object written last, usually a heartbeat blob, and what every push and fetch of beat
and of the executor then fails on (111, 2026-11-14: a day without heartbeats or jobs). A finished loose object is
never empty; a writer's tmp_obj_* file may be and is left alone.
With --probe (e.g. `ssh <host> python3 - --probe < beat`), prints the host's NUMA/L3 topology, memory, GPUs, disks,
container backend and suggested slot CPU ranges as JSON without reading machines.json.

macOS (DARWIN) has no /proc and pins no thread: CPU times come from Mach, memory from sysctl and vm_stat, and the
machine is one node. A slot there has no CPUs of its own (its `cpus` only count its threads), so its busy threads are
the machine's: what its load takes of the slot's share once the CPUs outside the slot are full, or the whole load up
to the slot's size while the slot runs a job; its top processes are the machine's.
"""
import argparse
import collections
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.abspath(__file__)) if "__file__" in globals() else os.getcwd()
PULLED = os.path.join(ROOT, ".git", "cf-pull.json")
HOMES = os.path.join(ROOT, ".git", "cf-homes.json")
PULL = 600
BUDGET = 50              # seconds a run may take (cron ends it after 55): what is left bounds a main directory's fetch
HOME_FETCH = 30
START = time.time()
DARWIN = sys.platform == "darwin"


def run(cmd, timeout=20, shell=False):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, shell=shell)
        return r.stdout if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def cpu_list(spec):
    out = []
    for part in spec.replace(" ", "").split(","):
        if not part:
            continue
        a, _, b = part.partition("-")
        out += range(int(a), int(b or a) + 1)
    return out


def compress(cs):
    cs, out, i = sorted(cs), [], 0
    while i < len(cs):
        j = i
        while j + 1 < len(cs) and cs[j + 1] == cs[j] + 1:
            j += 1
        out.append(f"{cs[i]}-{cs[j]}" if j > i else str(cs[i]))
        i = j + 1
    return ",".join(out)


def cpu_times():
    t = {}
    for line in open("/proc/stat"):
        if line.startswith("cpu") and line[3].isdigit():
            p = line.split()
            v = [int(x) for x in p[1:9]]
            t[int(p[0][3:])] = (sum(v), v[3] + v[4])
    return t


if DARWIN:
    import ctypes
    LIBC = ctypes.CDLL(None, use_errno=True)
    LIBC.mach_host_self.restype = ctypes.c_uint
    LIBC.host_processor_info.argtypes = [ctypes.c_uint, ctypes.c_int, ctypes.POINTER(ctypes.c_uint),
                                         ctypes.POINTER(ctypes.POINTER(ctypes.c_uint)), ctypes.POINTER(ctypes.c_uint)]
    LIBC.vm_deallocate.argtypes = [ctypes.c_uint, ctypes.c_void_p, ctypes.c_size_t]
    MACH_HOST = LIBC.mach_host_self()

    def cpu_times():
        """{cpu: (ticks, idle ticks)} from host_processor_info(PROCESSOR_CPU_LOAD_INFO): user, system, idle, nice."""
        n, info, count = ctypes.c_uint(), ctypes.POINTER(ctypes.c_uint)(), ctypes.c_uint()
        if LIBC.host_processor_info(MACH_HOST, 2, ctypes.byref(n), ctypes.byref(info), ctypes.byref(count)):
            return {}
        t = {c: (sum(info[4 * c + k] for k in range(4)), info[4 * c + 2]) for c in range(n.value)}
        LIBC.vm_deallocate(ctypes.c_uint.in_dll(LIBC, "mach_task_self_"), ctypes.cast(info, ctypes.c_void_p),
                           count.value * 4)
        return t


def busy_per_cpu(seconds=2.0):
    a = cpu_times()
    time.sleep(seconds)
    b = cpu_times()
    return {c: 1 - (b[c][1] - a[c][1]) / max(1, b[c][0] - a[c][0]) for c in b if c in a}


def numa_nodes():
    if DARWIN:               # one node: every CPU of the machine
        n = len(cpu_times())
        return [(0, f"0-{n - 1}")] if n else []
    base = "/sys/devices/system/node"
    nodes = []
    for d in sorted(os.listdir(base)) if os.path.isdir(base) else []:
        if d.startswith("node") and d[4:].isdigit():
            nodes.append((int(d[4:]), open(f"{base}/{d}/cpulist").read().strip()))
    return sorted(nodes)


def memory():
    if DARWIN:
        # Available as the system would give it without swapping: free, inactive, speculative and purgeable pages.
        total = int(run(["sysctl", "-n", "hw.memsize"]).strip() or 0)
        text = run(["vm_stat"])
        page = int((re.search(r"page size of (\d+) bytes", text) or [0, 16384])[1])
        pages = sum(int(m.group(1)) for k in ("free", "inactive", "speculative", "purgeable")
                    for m in [re.search(rf"Pages {k}:\s+(\d+)", text)] if m)
        return {"total": total, "avail": min(total, pages * page)}
    m = {}
    for line in open("/proc/meminfo"):
        k, v = line.split(":")
        m[k] = int(v.split()[0]) * 1024
    return {"total": m["MemTotal"], "avail": m["MemAvailable"]}


def disks(mounts):
    out = []
    for mount in mounts:
        try:
            u = shutil.disk_usage(os.path.expanduser(mount))
            out.append({"mount": mount, "total": u.total, "free": u.free})
        except OSError as e:
            out.append({"mount": mount, "error": str(e)})
    return out


def user_of(pid):
    try:
        uid = os.stat(f"/proc/{pid}").st_uid
    except OSError:
        return "?"
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return "容器" if uid >= 100000 else str(uid)


def gpus():
    q = run(["nvidia-smi", "--query-gpu=index,uuid,name,utilization.gpu,memory.used,memory.total",
             "--format=csv,noheader,nounits"])
    out, by_uuid = [], {}
    for line in q.splitlines():
        p = [x.strip() for x in line.split(",")]
        if len(p) < 6:
            continue
        g = {"index": int(p[0]), "name": p[2], "util": int(p[3] or 0), "mem_used": int(p[4] or 0) << 20,
             "mem_total": int(p[5] or 0) << 20, "procs": []}
        by_uuid[p[1]] = g
        out.append(g)
    apps = run(["nvidia-smi", "--query-compute-apps=gpu_uuid,pid,used_memory", "--format=csv,noheader,nounits"])
    for line in apps.splitlines():
        p = [x.strip() for x in line.split(",")]
        if len(p) == 3 and p[0] in by_uuid:
            by_uuid[p[0]]["procs"].append({"user": user_of(p[1]), "mem": int(p[2] or 0) << 20})
    return out


def containers():
    text = run(["incus", "list", "--format", "json"], timeout=30)
    if not text and shutil.which("sg"):
        text = run(["sg", "incus-admin", "-c", "incus list --format json"], timeout=30)
    if not text:
        return None if not shutil.which("incus") else []
    out = []
    for c in json.loads(text):
        cfg, st = c.get("config") or {}, c.get("state") or {}
        work = [d.get("source") for d in (c.get("expanded_devices") or {}).values()
                if d.get("type") == "disk" and d.get("path") != "/" and d.get("readonly") != "true"]
        out.append({"name": c["name"], "state": c.get("status"), "cpus": cfg.get("limits.cpu"),
                    "mem_limit": cfg.get("limits.memory"), "mem_used": (st.get("memory") or {}).get("usage"),
                    "procs": st.get("processes"), "image": cfg.get("image.description"),
                    "gpu": any(d.get("type") == "gpu" for d in (c.get("expanded_devices") or {}).values()),
                    "work": [w for w in work if w]})
    return out


def processes():
    """(cpu, threads, owner, command) of each process over 5% CPU; owner as owner_of names it."""
    out = []
    if DARWIN:               # ps there knows no psr (a thread has no CPU of its own), and comm is the whole path
        for line in run(["ps", "-Ao", "pid=,pcpu=,uid=,comm="]).splitlines():
            p = line.split(None, 3)
            if len(p) == 4 and float(p[1]) >= 5:
                out.append((None, float(p[1]) / 100, owner_of(int(p[0]), int(p[2])), os.path.basename(p[3])))
        return out
    for line in run(["ps", "-eo", "pid=,psr=,pcpu=,uid=,comm="]).splitlines():
        p = line.split(None, 4)
        if len(p) == 5 and float(p[2]) >= 5:
            out.append((int(p[1]), float(p[2]) / 100, owner_of(int(p[0]), int(p[3])), p[4]))
    return out


def container_of(pid):
    """The incus container a process runs in (its cgroup lxc.payload.<name>), or None."""
    try:
        for line in open(f"/proc/{pid}/cgroup"):
            m = re.search(r"/lxc\.payload\.([^/]+)", line)
            if m:
                return m.group(1)
    except OSError:
        pass
    return None


CONTAINER_OWNER = {}


def owner_of(pid, uid):
    """A host user by name; a process in a container by who holds that container's slot (the job's or the hold's
    requester, from the executor), else "容器 <name>"."""
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        pass
    if uid < 100000:
        return str(uid)
    c = container_of(pid)
    if c is None:
        return "容器"
    return CONTAINER_OWNER.get(c) or f"容器 {c}"


def executor_state(name):
    """What the machine's executor last wrote (every few seconds while it runs); None when it is not running."""
    try:
        st = json.load(open(os.path.expanduser(f"~/curryflow/exec/{name}/state.json")))
    except (OSError, ValueError):
        return None
    return st if time.time() - st.get("at", 0) < 120 else None


def collect(name, conf):
    ex = executor_state(name)
    CONTAINER_OWNER.clear()
    for sname, e in ((ex or {}).get("slots") or {}).items():
        c, job = (conf.get("slots", {}).get(sname) or {}).get("container"), e.get("job") or {}
        if c and job.get("who"):
            CONTAINER_OWNER[c] = f"{job['who'].split(':')[0]}（{c}）"
    busy = busy_per_cpu()
    procs = processes()
    total = lambda spec: round(sum(busy.get(c, 0) for c in cpu_list(spec)), 1)
    jobs = {sname for sname, e in ((ex or {}).get("slots") or {}).items() if e.get("job")}

    def slot_busy(sname, spec):
        if not DARWIN:
            return total(spec)
        n, load = len(cpu_list(spec)), sum(busy.values())
        return round(min(n, load if sname in jobs else max(0.0, load - (len(busy) - n))), 1)

    def top(spec, n=2):
        cs, agg = set(cpu_list(spec)), collections.Counter()
        for psr, load, uid, comm in procs:
            if psr is None or psr in cs:
                agg[(uid, comm)] += load
        return [{"user": u, "cmd": c, "threads": round(v, 1)} for (u, c), v in agg.most_common(n) if v >= 0.5]

    users = collections.Counter()
    for psr, load, uid, comm in procs:
        users[uid] += load
    if DARWIN:               # for the page: this machine's slots are shares, not CPUs
        conf = {**conf, "slots": {s: {**d, "note": d.get("note") or "macOS：不钉核，槽位是线程数配额"}
                                  for s, d in conf.get("slots", {}).items()}}
    beat = {
        "machine": name, "host": os.uname().nodename, "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "threads": len(busy), "busy": round(sum(busy.values()), 1), "load": os.getloadavg()[0],
        "nodes": [{"id": i, "cpus": spec, "threads": len(cpu_list(spec)), "busy": total(spec)} for i, spec in numa_nodes()],
        "mem": memory(), "disks": disks(conf.get("disks", ["/"])), "gpus": gpus(), "containers": containers(),
        "slots": [{"name": s, "cpus": d["cpus"], "threads": len(cpu_list(d["cpus"])), "busy": slot_busy(s, d["cpus"]),
                   "top": top(d["cpus"]), **{k: d[k] for k in ("mem", "container", "note") if k in d}}
                  for s, d in conf.get("slots", {}).items()],
        "users": [{"user": u, "threads": round(v, 1)} for u, v in users.most_common(6) if v >= 0.5],
        "executor": ex and {k: ex.get(k) for k in ("at", "poll", "queued", "memcap", "jobs")},
        "pull": pulled(),
    }
    for s in beat["slots"]:
        e = ((ex or {}).get("slots") or {}).get(s["name"])
        if e:
            s["sched"] = e.get("state")
            if e.get("job"):
                s["job"] = e["job"]
    for c in beat["containers"] or []:
        if c.get("cpus") and c.get("state") == "Running":
            c["busy"] = total(c["cpus"])
    return beat


def probe_darwin():
    sysctl = lambda k: run(["sysctl", "-n", k]).strip()
    levels = []
    for i in range(int(sysctl("hw.nperflevels") or 0)):
        g = lambda k: sysctl(f"hw.perflevel{i}.{k}")
        levels.append({"name": g("name"), "cpus": int(g("logicalcpu") or 0), "cpus_per_l2": int(g("cpusperl2") or 0),
                       "l2_mb": int(g("l2cachesize") or 0) >> 20})
    load, mem = busy_per_cpu(), memory()
    print(json.dumps({
        "host": os.uname().nodename, "os": "macOS " + run(["sw_vers", "-productVersion"]).strip(),
        "cpu": sysctl("machdep.cpu.brand_string"), "mem_gb": mem["total"] >> 30, "avail_gb": mem["avail"] >> 30,
        "threads": len(load), "busy_threads": round(sum(load.values()), 1), "perf_levels": levels, "pinning": False,
        "note": "macOS 不钉核、没有 cgroup：槽位写成线程数配额（cpus 0-<N-1>）和内存预算，机器标 named_only",
        "gpus": gpus(), "containers": containers(), "disks": disks(["/", os.path.expanduser("~")]),
        "load1": os.getloadavg()[0],
    }, ensure_ascii=False, indent=1))


def probe():
    if DARWIN:
        return probe_darwin()
    rows = [l.split(",") for l in run(["lscpu", "-p=CPU,CORE,SOCKET,NODE,CACHE"]).splitlines() if not l.startswith("#")]
    l3 = {}
    for r in rows:
        cpu, core, sock, node = r[:4]
        key = (sock, node or "0", r[-1])
        l3.setdefault(key, {"cpus": [], "cores": set()})
        l3[key]["cpus"].append(int(cpu))
        l3[key]["cores"].add(core)
    load = busy_per_cpu()
    nodes = {}
    for (_, node, _), v in l3.items():
        n = nodes.setdefault(node, {"cpus": [], "l3": []})
        n["cpus"] += v["cpus"]
        n["l3"].append(compress(v["cpus"]))
    for node, n in nodes.items():
        mi = f"/sys/devices/system/node/node{node}/meminfo"
        if os.path.exists(mi):
            for l in open(mi):
                if "MemTotal" in l:
                    n["mem_gb"] = int(l.split()[-2]) >> 20
                if "MemFree" in l:
                    n["free_gb"] = int(l.split()[-2]) >> 20
        n["busy_pct"] = round(100 * sum(load.get(c, 0) for c in n["cpus"]) / max(1, len(n["cpus"])))
        n["cpus"] = compress(n["cpus"])
    sims, acc = [], None
    for key in sorted(l3, key=lambda k: min(l3[k]["cpus"])):
        v = l3[key]
        if acc and acc["node"] == key[1]:
            acc["cpus"] += v["cpus"]
            acc["cores"] |= v["cores"]
        else:
            acc = {"node": key[1], "cpus": list(v["cpus"]), "cores": set(v["cores"])}
        if len(acc["cores"]) >= 8:
            sims.append({"node": acc["node"], "cpus": compress(acc["cpus"]), "cores": len(acc["cores"])})
            acc = None
    mem = memory()
    print(json.dumps({
        "host": os.uname().nodename, "mem_gb": mem["total"] >> 30, "avail_gb": mem["avail"] >> 30,
        "numa": nodes, "sim_slots": sims, "gpus": gpus(), "containers": containers(),
        "disks": disks(["/", os.path.expanduser("~")]), "load1": os.getloadavg()[0],
    }, ensure_ascii=False, indent=1))


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def keep(path, state):
    with open(path + ".tmp", "w") as f:
        json.dump(state, f, ensure_ascii=False)
    os.replace(path + ".tmp", path)


def pulled():
    p = load(PULLED)
    head = run(["git", "-C", ROOT, "rev-parse", "HEAD"]).strip()
    return {"head": head[:12] or None, "ok": p.get("ok"), "at": p.get("at"), "error": p.get("error")}


def pull(proxy):
    """git pull every PULL seconds; how it went goes into the heartbeats, so a clone that falls behind shows."""
    last = load(PULLED)
    if time.time() - last.get("tried", 0) < PULL:
        return
    keep(PULLED, {**last, "tried": time.time()})
    try:
        git("pull", "-q", "--ff-only", proxy=proxy)
        keep(PULLED, {"tried": time.time(), "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "ok": True})
    except (SystemExit, subprocess.TimeoutExpired) as e:
        keep(PULLED, {"tried": time.time(), "at": last.get("at"), "ok": False, "error": str(e)[-300:]})


def drop_empty_objects():
    """Remove the zero-length loose objects of the clone (see the header); a file that cannot be removed stays."""
    base = os.path.join(ROOT, ".git", "objects")
    try:
        fans = [d.path for d in os.scandir(base) if re.fullmatch(r"[0-9a-f]{2}", d.name)]
    except OSError:
        return
    for fan in fans:
        try:
            for f in os.scandir(fan):
                if re.fullmatch(r"[0-9a-f]{38}", f.name) and f.is_file(follow_symlinks=False) and not f.stat().st_size:
                    os.unlink(f.path)
        except OSError:
            pass


def home_paths(projects, machine):
    return {p: d["home"][machine] for p, d in projects.items()
            if isinstance(d, dict) and isinstance(d.get("home"), dict) and machine in d["home"]}


def homes(projects, machine):
    """What the last look at this machine's main directories found, for the heartbeat."""
    state = load(HOMES)
    return [{"project": p, "path": path, **{k: v for k, v in state.get(p, {}).items() if k != "tried"}}
            for p, path in home_paths(projects, machine).items()]


def sync_homes(projects, machine, proxy):
    """Every PULL seconds, each main directory of this machine at its hub's main (sync_home); one that this run has
    no time left for waits for the next run."""
    state = load(HOMES)
    for p, path in home_paths(projects, machine).items():
        last = state.get(p, {})
        left = BUDGET - (time.time() - START)
        if time.time() - last.get("tried", 0) < PULL or left < 10:
            continue
        state[p] = {**last, "tried": time.time()}
        keep(HOMES, state)
        try:
            found = sync_home(os.path.expanduser(path), projects[p]["hub"], proxy, min(HOME_FETCH, left - 5))
            state[p] = {"tried": time.time(), "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), **found}
        except (SystemExit, subprocess.TimeoutExpired, OSError) as e:
            state[p] = {**last, "tried": time.time(), "error": str(e)[-300:]}
        keep(HOMES, state)


def sync_home(path, hub, proxy, timeout):
    """Fetch the hub's main into the clone at `path` and fast-forward its main to it; what the clone is at then."""
    g = lambda *args, **kw: git(*args, cwd=path, **kw)
    g("fetch", "-q", "--no-tags", "--no-recurse-submodules", hub, "+refs/heads/main:refs/remotes/hub/main", proxy=proxy,
      timeout=timeout)
    branch = g("rev-parse", "--abbrev-ref", "HEAD")           # HEAD when no branch is checked out

    def state():
        main = g("for-each-ref", "--format=%(objectname)", "refs/heads/main")
        if not main:
            return {"branch": branch, "main": None, "error": "the clone has no branch main"}
        ahead, behind = g("rev-list", "--left-right", "--count", "refs/heads/main...refs/remotes/hub/main").split()
        return {"branch": branch, "main": main[:12], "behind": int(behind), "ahead": int(ahead)}

    found = state()
    if found.get("behind") and not found["ahead"]:
        try:
            if branch == "main":       # in a session of its own: the work tree's update is not cut short with this run
                g("merge", "-q", "--ff-only", "refs/remotes/hub/main", timeout=120, detach=True)
            else:
                g("fetch", "-q", ".", "refs/remotes/hub/main:refs/heads/main")
            found = state()
        except (SystemExit, subprocess.TimeoutExpired) as e:
            found["error"] = str(e)[-300:]
    return found


def git(*args, input=None, proxy=None, cwd=None, timeout=45, detach=False):
    ssh = ("ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new"
           " -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ControlMaster=auto -o ControlPersist=10m -o ControlPath=~/.ssh/cf-%C")
    if proxy:
        ssh += f" -o 'ProxyCommand=nc -X connect -x {proxy} %h %p'"
    env = {**os.environ, "GIT_SSH_COMMAND": ssh, "GIT_TERMINAL_PROMPT": "0"}
    r = subprocess.run(["git", *args], cwd=cwd or ROOT, input=input, capture_output=True, text=True, env=env,
                       timeout=timeout, start_new_session=detach)
    if r.returncode:
        raise SystemExit(f"git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout.strip()


def main():
    globals().update(json.loads(os.environ.get("CF_POOL_TUNE") or "{}"))
    ap = argparse.ArgumentParser()
    ap.add_argument("--machine")
    ap.add_argument("--print", action="store_true")
    ap.add_argument("--probe", action="store_true")
    a = ap.parse_args()
    if a.probe:
        return probe()
    if not a.machine:
        ap.error("--machine is required (or use --probe)")
    pool = json.load(open(os.path.join(ROOT, "machines.json")))
    conf, projects = pool["machines"].get(a.machine), pool.get("projects") or {}
    if conf is None:
        raise SystemExit(f"machines.json has no machine {a.machine}")
    drop_empty_objects()
    beat = collect(a.machine, conf)
    if home_paths(projects, a.machine):
        beat["homes"] = homes(projects, a.machine)
    text = json.dumps(beat, ensure_ascii=False)
    if a.print:
        print(json.dumps(beat, ensure_ascii=False, indent=1))
        return
    proxy = conf.get("hub_proxy")
    blob = git("hash-object", "-w", "--stdin", input=text)
    git("push", "-q", "-f", "origin", f"{blob}:refs/hb/{a.machine}", proxy=proxy)
    pull(proxy)
    sync_homes(projects, a.machine, proxy)
    if time.localtime().tm_min == 7:
        git("gc", "-q", "--prune=10.minutes.ago")      # not now: executor and flow push blobs they have just written


if __name__ == "__main__":
    main()
