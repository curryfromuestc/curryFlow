#!/bin/sh
# The pool's beat on a Mac: a launchd daemon run as this user every minute, what the cron line is on Linux; and the
# sudo rule the executor needs for the jobs' own daemons.
#
# usage: mac-agents install NAME    write and start com.curryflow.beat for machine NAME, and the sudo rule
#        mac-agents remove          stop and delete them
#        mac-agents status          whether beat is loaded
#
# Run from the clone of the pool repository (~/curryflow/machines) as the user the jobs run as; install and remove
# ask for that user's sudo password once. beat is a daemon of the system domain with UserName set, as each job's
# supervisor (cf.<id>, see executor) is: they run without anyone logged in at the Mac. The executor starts and stops
# those through sudo (a plist there must be owned by root); /etc/sudoers.d/curryflow lets this user do exactly that
# without a password.
set -e
here=$(cd "$(dirname "$0")" && pwd)
dir=/Library/LaunchDaemons
user=$(id -un)
group=$(id -gn)
labels="com.curryflow.beat"
sudoers=/etc/sudoers.d/curryflow

plist() {  # LABEL ERR KEY ARG...
    label=$1 err=$2 key=$3
    shift 3
    {
        printf '<?xml version="1.0" encoding="UTF-8"?>\n'
        printf '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
        printf '<plist version="1.0"><dict>\n'
        printf '  <key>Label</key><string>%s</string>\n' "$label"
        printf '  <key>UserName</key><string>%s</string>\n' "$user"
        printf '  <key>GroupName</key><string>%s</string>\n' "$group"
        printf '  <key>EnvironmentVariables</key><dict>\n'
        printf '    <key>HOME</key><string>%s</string>\n' "$HOME"
        printf '    <key>USER</key><string>%s</string>\n' "$user"
        printf '    <key>LOGNAME</key><string>%s</string>\n' "$user"
        printf '    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>\n'
        printf '  </dict>\n'
        printf '  <key>ProgramArguments</key><array>\n    <string>/usr/bin/python3</string>\n'
        for a in "$@"; do printf '    <string>%s</string>\n' "$a"; done
        printf '  </array>\n'
        printf '  <key>WorkingDirectory</key><string>%s</string>\n' "$here"
        printf '  <key>RunAtLoad</key><true/>\n  %s\n' "$key"
        printf '  <key>StandardOutPath</key><string>/dev/null</string>\n'
        printf '  <key>StandardErrorPath</key><string>%s</string>\n' "$err"
        printf '</dict></plist>\n'
    } > "$tmp/$label.plist"
}

case ${1:-} in
install)
    name=${2:?usage: mac-agents install NAME}
    grep -q "\"$name\"" "$here/machines.json" || { echo "machines.json has no machine $name" >&2; exit 1; }
    mkdir -p "$HOME/curryflow/exec/$name"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    plist com.curryflow.beat /dev/null '<key>StartInterval</key><integer>60</integer>' "$here/beat" --machine "$name"
    printf '%s ALL=(root) NOPASSWD: /bin/launchctl bootstrap system *, /bin/launchctl bootout system/cf.*, %s\n' \
        "$user" "/usr/sbin/chown root\\:wheel $HOME/*/cf.*.plist" > "$tmp/sudoers"
    sudo visudo -cqf "$tmp/sudoers"
    sudo install -m 440 -o root -g wheel "$tmp/sudoers" "$sudoers"
    # the resident executor of the earlier mac-agents
    sudo launchctl bootout system/com.curryflow.executor 2>/dev/null || true
    sudo rm -f "$dir/com.curryflow.executor.plist"
    for label in $labels; do
        sudo launchctl bootout "system/$label" 2>/dev/null || true
        sudo install -m 644 -o root -g wheel "$tmp/$label.plist" "$dir/$label.plist"
        sudo launchctl bootstrap system "$dir/$label.plist"
    done
    echo "installed: $labels (machine $name, user $user)"
    ;;
remove)
    for label in $labels; do
        sudo launchctl bootout "system/$label" 2>/dev/null || true
        sudo rm -f "$dir/$label.plist"
    done
    sudo rm -f "$sudoers"
    echo "removed: $labels"
    ;;
status)
    for label in $labels; do
        state=$(launchctl print "system/$label" 2>/dev/null | sed -n 's/^[[:space:]]*state = //p' | head -1)
        echo "$label: ${state:-not loaded}"
    done
    ;;
*)
    sed -n 2,6p "$0" >&2
    exit 2
    ;;
esac
