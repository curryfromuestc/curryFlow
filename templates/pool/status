#!/usr/bin/env python3
"""The pool's status as JSON, from the heartbeats the machines write here (~/curryflow/hb/<machine>.json, see beat).

usage: status [--history FILE]

Run every minute on the curryPlan machine from a clone of the pool repository (machines.json, pulled from GitHub).
With --history, FILE keeps the last three hours of each machine's busy threads and used memory, one point a minute,
and the output carries it. A slot's job and a machine's alerts are in its heartbeat.
"""
import argparse
import glob
import json
import os
import time

ROOT = os.path.dirname(os.path.abspath(__file__))
KEEP = 180


def heartbeats():
    out = {}
    for path in glob.glob(os.path.expanduser("~/curryflow/hb/*.json")):
        try:
            d = json.load(open(path))
        except (OSError, ValueError):
            continue
        if isinstance(d, dict) and isinstance(d.get("machine"), str):
            out[d["machine"]] = d
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--history")
    a = ap.parse_args()
    conf = json.load(open(os.path.join(ROOT, "machines.json")))
    beats = heartbeats()
    hist = {}
    if a.history:
        if os.path.exists(a.history):
            hist = json.load(open(a.history))
        for name, b in beats.items():
            points = hist.setdefault(name, [])
            if not points or points[-1][0] != b["at"]:
                points.append([b["at"], b["busy"], b["mem"]["total"] - b["mem"]["avail"]])
            del points[:-KEEP]
        tmp = a.history + ".tmp"
        json.dump(hist, open(tmp, "w"))
        os.replace(tmp, a.history)
    out = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "now": int(time.time()),
           "machines": [{"name": name, "conf": c, "beat": beats.get(name), "history": hist.get(name, [])}
                        for name, c in conf["machines"].items()]}
    print(json.dumps(out, ensure_ascii=False))


if __name__ == "__main__":
    main()
