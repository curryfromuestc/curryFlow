#!/usr/bin/env python3
"""The pool's status as JSON, from the heartbeats fetched into this clone (refs/hb/*).

usage: status [--history FILE]

Run every minute on the curryPlan machine after `git fetch origin '+refs/hb/*:refs/hb/*'`. With --history, FILE keeps
the last three hours of each machine's busy threads and used memory, one point a minute, and the output carries it.
"""
import argparse
import json
import os
import subprocess
import time

ROOT = os.path.dirname(os.path.abspath(__file__))
KEEP = 180


def git(*args):
    r = subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--history")
    a = ap.parse_args()
    conf = json.load(open(os.path.join(ROOT, "machines.json")))
    beats = {}
    for ref in git("for-each-ref", "--format=%(refname)", "refs/hb/").split():
        text = git("cat-file", "blob", ref)
        if text:
            beats[ref.rsplit("/", 1)[1]] = json.loads(text)
    hist = {}
    if a.history:
        if os.path.exists(a.history):
            hist = json.load(open(a.history))
        for name, b in beats.items():
            points = hist.setdefault(name, [])
            if not points or points[-1][0] != b["at"]:
                points.append([b["at"], b["busy"], b["mem"]["total"] - b["mem"]["avail"]])
            del points[:-KEEP]
        tmp = a.history + ".tmp"
        json.dump(hist, open(tmp, "w"))
        os.replace(tmp, a.history)
    out = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "hub": conf["hub"],
           "machines": [{"name": name, "conf": c, "beat": beats.get(name), "history": hist.get(name, [])}
                        for name, c in conf["machines"].items()]}
    print(json.dumps(out, ensure_ascii=False))


if __name__ == "__main__":
    main()
