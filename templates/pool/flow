#!/usr/bin/env python3
"""Runs a job in a slot that was agreed on beforehand: over ssh, on the machine's executor; nothing is queued.

usage: flow run --machine M --slot S --project P [--commit REV | --here] [--timeout SECONDS] [--clean] [--no-wait]
                -- COMMAND...
       flow wait [M:]ID          (also: flow attach) follow a job to its end
       flow cancel [M:]ID
       flow log [M:]ID [-n N]
       flow ls [--machine M]...

run    starts COMMAND in slot S of machine M for project P at a commit and waits for its end: it prints the machine's
       alerts (memory, swapping) as they come, then the last 40 lines of the log, and exits with the job's exit code
       (124 timeout, 143 cancelled, 99 it could not be started, 255 lost). A slot runs one job: a busy slot is an
       error. REV is a commit, or a branch or tag of the project's GitHub repository (default main); --here takes the
       current repository's HEAD and pushes it straight into the machine's mirror (no branch on GitHub is needed).
       A COMMAND of one word is run by bash -c, so "make -j && ctest" works. With --no-wait it prints M:ID and
       returns; the job does not depend on this command or its ssh connection.
wait   follows a job again (after --no-wait, or when the connection broke); interrupting it leaves the job running.
ls     the jobs of each machine's slots (running and the latest ended) and the machines' alerts.
An ID without "M:" is looked for on every machine.

It runs from a clone of the pool repository (~/curryflow/machines): machines.json names the machines (each reached by
`ssh <name>`, or the ssh host its "ssh" names for the machine flow runs on, so this host's ~/.ssh/config has an
entry for each) and the projects (their GitHub "repo"). On the machine itself it calls the executor directly. Who asks is $CF_WHO, else user@host.
"""
import argparse
import concurrent.futures
import getpass
import json
import os
import re
import shlex
import subprocess
import sys
import time
import unicodedata

ROOT = os.path.dirname(os.path.realpath(__file__))
SHA = re.compile(r"[0-9a-f]{40}")
TIMEOUT_MAX = 86400
RETRY = 15
VERDICT = {"exit": "结束", "timeout": "超时", "cancelled": "已取消", "error": "没跑起来", "lost": "丢了"}
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "-o", "ServerAliveInterval=15",
       "-o", "ServerAliveCountMax=4"]


def die(text):
    raise SystemExit(f"flow: {text}")


def note(text):
    print(f"[flow] {text}", file=sys.stderr, flush=True)


def machine_conf(name):
    m = CONF["machines"].get(name)
    if not m:
        die(f"machines.json 里没有机器 {name}（有 {'、'.join(CONF['machines'])}）")
    return m


def local(name):
    return machine_conf(name).get("host") == os.uname().nodename


def route(name):
    """How this host reaches machine NAME by ssh: machines.json "ssh" ({launcher machine: ssh host}), else NAME."""
    r = machine_conf(name).get("ssh")
    return r.get(LAUNCHER, name) if isinstance(r, dict) else r or name


def remote(name, args, input=None, capture=True, timeout=None):
    """executor ARGS on machine NAME: (exit code, stdout)."""
    cmd = ["python3", "curryflow/machines/executor", *args]
    if local(name):
        cmd = [sys.executable, os.path.join(ROOT, "executor"), *args]
    else:
        cmd = [*SSH, route(name), "cd && " + shlex.join(cmd)]
    try:
        r = subprocess.run(cmd, input=input, text=True, stdout=subprocess.PIPE if capture else None, timeout=timeout)
    except subprocess.TimeoutExpired:
        return 255, ""
    return r.returncode, r.stdout or ""


def who():
    return os.environ.get("CF_WHO") or f"{getpass.getuser()}@{os.uname().nodename}"


def git(*args, cwd=None, timeout=120):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, timeout=timeout)
    if r.returncode:
        die(f"git {' '.join(args[:3])}：{r.stderr.strip()[-300:]}")
    return r.stdout.strip()


def resolve(a, repo):
    """(commit, whether this repository has it and pushes it to the machine)."""
    here = os.getcwd()
    if a.here:
        sha = git("rev-parse", "--verify", "HEAD^{commit}", cwd=here)
        if git("--no-optional-locks", "status", "--porcelain", "--untracked-files=no", cwd=here):
            note("工作区有没提交的改动，作业跑的是 HEAD，不带这些改动")
        return sha, True
    rev = a.commit or "main"
    if SHA.fullmatch(rev):
        return rev, False
    out = git("ls-remote", repo, rev, f"refs/heads/{rev}", f"refs/tags/{rev}")
    refs = {ref: sha for sha, ref in (line.split("\t") for line in out.splitlines())}
    for name in (f"refs/heads/{rev}", f"refs/tags/{rev}^{{}}", f"refs/tags/{rev}", rev):
        if name in refs:
            return refs[name], False
    r = subprocess.run(["git", "rev-parse", "--verify", "-q", rev + "^{commit}"], cwd=here, capture_output=True, text=True)
    if r.returncode == 0:
        return r.stdout.strip(), True
    die(f"{repo} 上没有 {rev}，当前目录的仓库也解析不了它")


def push(machine, project, sha):
    """The commit into the machine's mirror of the project, under refs/cf/job/<sha> (prepare drops it)."""
    code, out = remote(machine, ["mirror", "--project", project])
    if code:
        die(f"{machine} 上建不了 {project} 的镜像")
    mirror = out.strip()
    url = mirror if local(machine) else f"{route(machine)}:{mirror}"
    env = {**os.environ, "GIT_SSH_COMMAND": shlex.join(SSH)}
    r = subprocess.run(["git", "push", "-q", "-f", url, f"{sha}:refs/cf/job/{sha}"], env=env,
                       capture_output=True, text=True, timeout=1800)
    if r.returncode:
        die(f"提交推不到 {machine} 的镜像：{r.stderr.strip()[-300:]}")


def show(d):
    for line in d.get("tail") or []:
        print(line)
    print(f"[flow] {d['machine']}:{d['id']} {VERDICT.get(d.get('reason'), d.get('reason'))}：退出码 {d.get('code')}，"
          f"{span(d.get('secs') or 0)}，{d['machine']}/{d['slot']}" + (f"；{d['note']}" if d.get("note") else "")
          + (f"；最后一行：{d['last']}" if d.get("last") else ""))
    print(f"[flow] 完整日志 {d['machine']}:{d['log']}")
    sys.stdout.flush()


def alert_text(al):
    return f"告警 {al.get('machine', '')} {al.get('what', '')}：{al.get('text', '')}"


def follow(machine, rid, args=("wait",)):
    """executor wait (or cancel) on the machine until its CF-END line; a broken connection is tried again."""
    while True:
        cmd = ["python3", "curryflow/machines/executor", *args, "--machine", machine, rid]
        if local(machine):
            cmd = [sys.executable, os.path.join(ROOT, "executor"), *cmd[2:]]
        else:
            cmd = [*SSH, route(machine), "cd && " + shlex.join(cmd)]
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
        try:
            for line in p.stdout:
                if line.startswith("CF-ALERT "):
                    note(alert_text({**json.loads(line[9:]), "machine": machine}))
                elif line.startswith("CF-END "):
                    p.wait()
                    return json.loads(line[7:])
        except KeyboardInterrupt:
            p.kill()
            note(f"不等了；作业不受影响：flow wait {machine}:{rid} 接着等，flow cancel {machine}:{rid} 结束")
            sys.exit(130)
        if p.wait() != 255:              # 255: ssh lost the connection; anything else is the executor's answer
            die(f"{machine} 上的 executor {args[0]} 没给出结论（见上面它的话）")
        note(f"和 {machine} 的连接断了，{RETRY} 秒后接着等（作业不受影响）")
        time.sleep(RETRY)


def code_of(d):
    c = d.get("code")
    return c if isinstance(c, int) and 0 <= c <= 255 else 1


def target(text):
    """[M:]ID -> (machine, id); without M every machine is asked."""
    if ":" in text:
        machine, rid = text.split(":", 1)
        machine_conf(machine)
        return machine, rid
    for machine, out in listing(list(CONF["machines"])):
        if any(j["id"] == text for j in (out or {}).get("jobs", [])):
            return machine, text
    die(f"哪台机器上都没有作业 {text}")


def cmd_run(a):
    if not a.command:
        die("-- 后面要有命令")
    m = machine_conf(a.machine)
    if a.slot not in m.get("slots", {}):
        die(f"{a.machine} 上没有槽位 {a.slot}（有 {'、'.join(m.get('slots', {})) or '无'}）")
    project = CONF.get("projects", {}).get(a.project) or die(
        f"machines.json 里没有项目 {a.project}（有 {'、'.join(CONF.get('projects', {}))}）")
    if not 0 < a.timeout <= TIMEOUT_MAX:
        die(f"--timeout 要在 1 到 {TIMEOUT_MAX} 秒之间")
    sha, mine = resolve(a, project["repo"])
    if mine:
        push(a.machine, a.project, sha)
    req = {"slot": a.slot, "project": a.project, "commit": sha, "repo": project["repo"], "argv": a.command,
           "timeout": a.timeout, "clean": a.clean, "who": who()}
    code, out = remote(a.machine, ["start", "--machine", a.machine], input=json.dumps(req), timeout=300)
    if code:
        die(f"{a.machine}/{a.slot} 上没起来（见上面 executor 的话）")
    rid = json.loads(out)["id"]
    if a.no_wait:
        print(f"{a.machine}:{rid}")
        return 0
    note(f"{a.machine}:{rid} {a.project}@{sha[:12]} 在 {a.slot}：{req['argv'][0] if len(a.command) == 1 else shlex.join(a.command)}")
    d = follow(a.machine, rid)
    show(d)
    return code_of(d)


def cmd_wait(a):
    machine, rid = target(a.id)
    d = follow(machine, rid)
    show(d)
    return code_of(d)


def cmd_cancel(a):
    machine, rid = target(a.id)
    d = follow(machine, rid, ("cancel",))
    show(d)
    return 0


def cmd_log(a):
    machine, rid = target(a.id)
    code, _ = remote(machine, ["log", "--machine", machine, rid, "-n", str(a.n)], capture=False)
    return code


def listing(machines):
    def one(name):
        code, out = remote(name, ["ls", "--machine", name], timeout=60)
        try:
            return name, json.loads(out) if code == 0 else None
        except ValueError:
            return name, None
    with concurrent.futures.ThreadPoolExecutor(len(machines) or 1) as ex:
        return list(ex.map(one, machines))


def width(text):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)


def table(title, cols, rows):
    print(f"{title}（{len(rows)}）")
    if not rows:
        return
    rows = [[str(c) for c in r] for r in [cols] + rows]
    w = [max(width(r[i]) for r in rows) for i in range(len(cols))]
    for r in rows:
        print("  " + "  ".join(c + " " * (w[i] - width(c)) for i, c in enumerate(r)).rstrip())


def span(seconds):
    s = max(0, int(seconds))
    return f"{s} 秒" if s < 120 else f"{s // 60} 分" if s < 7200 else f"{s / 3600:.1f} 小时"


def cut(text, n):
    text = str(text or "")
    return text if len(text) <= n else text[:n - 1] + "…"


def cmd_ls(a):
    machines = a.machine or [m for m, c in CONF["machines"].items() if c.get("slots")]
    res = listing(machines)
    t = time.time()
    run, done, alerts, gone = [], [], [], []
    for machine, out in res:
        if out is None:
            gone.append(machine)
            continue
        alerts += [{**al, "machine": machine} for al in out["alerts"]]
        for j in out["jobs"]:
            (run if "reason" not in j else done).append(j)
    if a.json:
        print(json.dumps({"running": run, "done": done, "alerts": alerts, "unreachable": gone}, ensure_ascii=False,
                         indent=1))
        return 0
    if gone:
        print(f"连不上：{'、'.join(gone)}")
    for al in alerts:
        print(alert_text(al))
    table("在跑", ["id", "机器/槽位", "谁", "项目", "命令", "已跑", "最后一行"],
          [[f"{j['machine']}:{j['id']}", f"{j['machine']}/{j['slot']}", j.get("who"), j.get("project"),
            cut(j.get("cmd"), 48), span(t - (j.get("start") or t)) + ("" if j.get("running") else "（进程不在了）"),
            cut(j.get("last"), 50)] for j in sorted(run, key=lambda j: j["id"])])
    done.sort(key=lambda j: j.get("end") or 0, reverse=True)
    table("最近结束", ["id", "结论", "退出码", "用时", "机器/槽位", "项目", "命令", "最后一行"],
          [[f"{j['machine']}:{j['id']}", VERDICT.get(j["reason"], j["reason"]), j.get("code"), span(j.get("secs") or 0),
            f"{j['machine']}/{j['slot']}", j.get("project"), cut(j.get("cmd"), 40), cut(j.get("last"), 60)]
           for j in done[:a.n]])
    return 0


def main():
    argv = sys.argv[1:]
    command = []
    if "--" in argv:
        i = argv.index("--")
        argv, command = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(prog="flow", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("--machine", required=True)
    r.add_argument("--slot", required=True)
    r.add_argument("--project", required=True)
    g = r.add_mutually_exclusive_group()
    g.add_argument("--commit")
    g.add_argument("--here", action="store_true")
    r.add_argument("--timeout", type=int, default=14400, help="秒，默认 4 小时")
    r.add_argument("--clean", action="store_true", help="跑之前清空槽位工作树的 .build/")
    r.add_argument("--no-wait", action="store_true")
    for name in ("wait", "attach", "cancel"):
        sub.add_parser(name).add_argument("id")
    lg = sub.add_parser("log")
    lg.add_argument("id")
    lg.add_argument("-n", type=int, default=100)
    ls = sub.add_parser("ls")
    ls.add_argument("--machine", action="append")
    ls.add_argument("-n", type=int, default=10, help="列多少个最近结束的")
    ls.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    a.command = command
    return {"run": cmd_run, "wait": cmd_wait, "attach": cmd_wait, "cancel": cmd_cancel, "log": cmd_log,
            "ls": cmd_ls}[a.cmd](a)


try:
    CONF = json.load(open(os.path.join(ROOT, "machines.json")))
except (OSError, ValueError) as e:
    raise SystemExit(f"flow: 读不了 {ROOT}/machines.json（flow 要放在 machines 仓库的 clone 里）：{e}")

LAUNCHER = next((n for n, c in CONF["machines"].items() if c.get("host") == os.uname().nodename), None)

if __name__ == "__main__":
    sys.exit(main())
