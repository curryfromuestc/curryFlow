BASE = os.path.expanduser("~/curryflow")
TICK, POLL, POLL_MAX, SWEEP, REAP = 3, 15, 120, 3600, 300
BUSY_MAX = 0.20          # a slot whose measured busy share is at or above this is somebody else's
WINDOW, MIN_WINDOW = 60, 6
BURST, QUIET = 15, 300   # on a shared machine a slot somebody loaded stays theirs for QUIET seconds after the load stops
LOST, RUN_GRACE, UNFIT = 600, 180, 1800
TOUCH, ALIVE, SPAWN, CANCEL_KILL = 5, 60, 60, 90
KEEP, TMP_KEEP, ABANDON_KEEP = 7 * 86400, 3600, 86400
HOLD_MAX_HOURS = 8
TIMEOUT_MAX = 86400
LOG_MAX, LOG_HEAD, EXEC_LOG_MAX = 256 << 20, 1 << 20, 4 << 20
GIT_TIMEOUT = 60
PRIO = {"gate": 0, "normal": 1, "night": 2}
TAGS = {"synth"}
ID = re.compile(r"\d{6}-\d{6}-[0-9a-f]{3,8}")
SHA = re.compile(r"[0-9a-f]{40}")
TMPREF = re.compile(r"refs/cf/tmp/\d{6}-\d{6}-[0-9a-f]{3,8}")
