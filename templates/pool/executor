class GitError(Exception):
    pass


class JobError(Exception):
    pass


class Cancelled(Exception):
    pass


def ssh_command(proxy=None, bulk=False):
    """ssh for git: a fetch of a project's commits (bulk) takes a connection of its own."""
    ssh = ("ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new"
           " -o ServerAliveInterval=15 -o ServerAliveCountMax=3")
    ssh += (" -o ControlMaster=no -o ControlPath=none" if bulk else
            " -o ControlMaster=auto -o ControlPersist=10m -o ControlPath=~/.ssh/cf-%C")
    if proxy:
        ssh += f" -o 'ProxyCommand=nc -X connect -x {proxy} %h %p'"
    return ssh


def git_env(proxy=None, bulk=False):
    return {**os.environ, "GIT_SSH_COMMAND": ssh_command(proxy, bulk), "GIT_TERMINAL_PROMPT": "0"}


def git(cwd, *args, input=None, timeout=None, proxy=None, bulk=False, env=None):
    timeout = timeout or GIT_TIMEOUT
    try:
        r = subprocess.run(["git", *args], cwd=cwd, input=input, capture_output=True, text=True,
                           env={**git_env(proxy, bulk), **(env or {})}, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise GitError(f"git {' '.join(args[:2])}: no answer in {timeout} s")
    if r.returncode:
        raise GitError(f"git {' '.join(args)}: {r.stderr.strip()[-400:]}")
    return r.stdout


def jload(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def jdump(path, obj):
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(obj, f, ensure_ascii=False)
    os.replace(tmp, path)


def cpu_list(spec):
    out = []
    for part in str(spec).replace(" ", "").split(","):
        if part:
            a, _, b = part.partition("-")
            out += range(int(a), int(b or a) + 1)
    return out


def mem_bytes(text):
    m = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([KMGT]?)(?:i?B)?\s*", str(text), re.I)
    return int(float(m.group(1)) * 1024 ** " KMGT".index(m.group(2).upper() or " ")) if m else None


def cpu_times():
    t = {}
    with open("/proc/stat") as f:
        for line in f:
            if line.startswith("cpu") and line[3].isdigit():
                p = line.split()
                v = [int(x) for x in p[1:9]]
                t[int(p[0][3:])] = (sum(v), v[3] + v[4])
    return t


def proc_stat(pid):
    """(state, ppid, start ticks) of a process, None when it is gone."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            p = f.read().rsplit(")", 1)[1].split()
        return p[0], int(p[1]), int(p[19])
    except (OSError, IndexError, ValueError):
        return None


def pid_alive(pid, ticks):
    s = proc_stat(pid)
    return bool(s and s[0] != "Z" and s[2] == ticks)


# ---- macOS: what Linux says in /proc, asked of libproc and Mach ------------------------------------------

if DARWIN:
    LIBC = ctypes.CDLL(None, use_errno=True)
    LIBPROC = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
    LIBC.mach_host_self.restype = ctypes.c_uint
    LIBC.host_processor_info.argtypes = [ctypes.c_uint, ctypes.c_int, ctypes.POINTER(ctypes.c_uint),
                                         ctypes.POINTER(ctypes.POINTER(ctypes.c_uint)), ctypes.POINTER(ctypes.c_uint)]
    LIBC.vm_deallocate.argtypes = [ctypes.c_uint, ctypes.c_void_p, ctypes.c_size_t]
    MACH_HOST = LIBC.mach_host_self()

    class BsdInfo(ctypes.Structure):
        """struct proc_bsdinfo (sys/proc_info.h), what proc_pidinfo(PROC_PIDTBSDINFO) fills."""
        _fields_ = [(n, ctypes.c_uint32) for n in ("flags", "status", "xstatus", "pid", "ppid", "uid", "gid", "ruid",
                                                    "rgid", "svuid", "svgid", "rfu")]
        _fields_ += [("comm", ctypes.c_char * 16), ("name", ctypes.c_char * 32)]
        _fields_ += [(n, ctypes.c_uint32) for n in ("nfiles", "pgid", "pjobc", "tdev", "tpgid")]
        _fields_ += [("nice", ctypes.c_int32), ("start_sec", ctypes.c_uint64), ("start_usec", ctypes.c_uint64)]

    def bsd_info(pid):
        """A process's proc_bsdinfo; None when it is gone, a zombie, or not this caller's to ask about."""
        b = BsdInfo()
        n = LIBPROC.proc_pidinfo(int(pid), 3, ctypes.c_uint64(0), ctypes.byref(b), ctypes.sizeof(b))
        return b if n == ctypes.sizeof(b) else None

    def all_pids():
        n = LIBPROC.proc_listallpids(None, 0)
        buf = (ctypes.c_int * (max(n, 0) + 256))()
        n = LIBPROC.proc_listallpids(buf, ctypes.sizeof(buf))
        return [p for p in buf[:max(n, 0)] if p > 0]

    def cpu_times():
        """{cpu: (ticks, idle ticks)} from host_processor_info(PROCESSOR_CPU_LOAD_INFO): user, system, idle, nice."""
        n, info, count = ctypes.c_uint(), ctypes.POINTER(ctypes.c_uint)(), ctypes.c_uint()
        if LIBC.host_processor_info(MACH_HOST, 2, ctypes.byref(n), ctypes.byref(info), ctypes.byref(count)):
            return {}
        t = {c: (sum(info[4 * c + k] for k in range(4)), info[4 * c + 2]) for c in range(n.value)}
        LIBC.vm_deallocate(ctypes.c_uint.in_dll(LIBC, "mach_task_self_"), ctypes.cast(info, ctypes.c_void_p),
                           count.value * 4)
        return t

    def proc_stat(pid):
        """(state, ppid, start in microseconds) of a process, None when it is gone (a zombie counts as gone)."""
        b = bsd_info(pid)
        return ("R", b.ppid, b.start_sec * 1000000 + b.start_usec) if b else None

    def coalition(pid):
        """The id of a process's resource coalition (proc_pidinfo(PROC_PIDCOALITIONINFO)); None when it cannot be
        read. launchd gives each of its jobs one, and a process keeps its parent's for life."""
        buf = (ctypes.c_uint64 * 5)()
        return buf[0] if LIBPROC.proc_pidinfo(int(pid), 20, ctypes.c_uint64(0), ctypes.byref(buf), 40) == 40 else None

    def coalition_pids(cid):
        """The processes of coalition cid but this one."""
        me = os.getpid()
        return [p for p in all_pids() if p != me and coalition(p) == cid] if cid else []

    def proc_cwd(pid):
        """A process's working directory (PROC_PIDVNODEPATHINFO: pvi_cdir's path); None when it cannot be read."""
        buf = ctypes.create_string_buffer(2352)
        if LIBPROC.proc_pidinfo(int(pid), 9, ctypes.c_uint64(0), buf, 2352) != 2352:
            return None
        return os.fsdecode(buf.raw[152:152 + 1024].split(b"\0", 1)[0])

    def proc_args(pid):
        """A process's executable path and arguments as the kernel keeps them (sysctl KERN_PROCARGS2); None when
        they cannot be read (another user's process)."""
        mib, size = (ctypes.c_int * 3)(1, 49, int(pid)), ctypes.c_size_t(1 << 20)
        buf = ctypes.create_string_buffer(size.value)
        if LIBC.sysctl(mib, 3, buf, ctypes.byref(size), None, ctypes.c_size_t(0)):
            return None
        return buf.raw[:size.value]


def tail_lines(path, n=40, cap=65536):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - cap))
            data = f.read()
    except OSError:
        return []
    lines = [ANSI.sub("", x).rstrip()[:400] for x in data.decode("utf-8", "replace").splitlines()]
    return (lines[1:] if size > cap else lines)[-n:]


def write_exit(rundir, code, reason, note=""):
    """The job's end, written once: whoever sees the end first (supervisor, launcher, wait, cancel) records it."""
    path = os.path.join(rundir, "exit.json")
    if os.path.exists(path):
        return
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump({"code": code, "reason": reason, "note": note, "end": time.time()}, f, ensure_ascii=False)
    try:
        os.link(tmp, path)
    except FileExistsError:
        pass
    os.unlink(tmp)




def git_busy(root):
    """Whether a git process may work in the repository at root (the work tree's top, or a bare repository): its
    arguments name it, it runs in it, or where it runs cannot be read (another user's, a container's)."""
    real = os.path.realpath(root)
    if DARWIN:
        for pid in all_pids():
            b = bsd_info(pid)
            comm = os.fsdecode(b.comm) if b else ""
            if pid == os.getpid() or (comm != "git" and not comm.startswith("git-")):
                continue
            args, cwd = proc_args(pid), proc_cwd(pid)
            if args is None or cwd is None:
                if bsd_info(pid):            # still there, and where it runs cannot be read
                    return True
                continue
            if real.encode() in args or root.encode() in args or cwd == real or cwd.startswith(real + "/"):
                return True
        return False
    for d in os.listdir("/proc"):
        if not d.isdigit() or int(d) == os.getpid():
            continue
        try:
            with open(f"/proc/{d}/comm") as f:
                comm = f.read().strip()
            if comm != "git" and not comm.startswith("git-"):
                continue
            with open(f"/proc/{d}/cmdline", "rb") as f:
                args = f.read()
            st = proc_stat(d)
            if not st or st[0] == "Z":
                continue
            if real.encode() in args or root.encode() in args:
                return True
            cwd = os.readlink(f"/proc/{d}/cwd")
        except PermissionError:
            return True
        except OSError:
            continue
        if cwd == real or cwd.startswith(real + "/"):
            return True
    return False


def clear_locks(root, gitdir, say, check):
    """Lock files a killed git left behind; only at a moment no git process may work in the repository."""
    locks = sorted({p for pat in LOCKS for p in glob.glob(os.path.join(gitdir, pat), recursive=True)})
    if not locks:
        return
    t = time.time()
    while git_busy(root):
        if time.time() - t >= LOCK_WAIT:
            return say(f"{gitdir} 里有锁文件，但 {LOCK_WAIT} 秒里一直有 git 进程可能在用它，不删")
        check()
        time.sleep(1)
    for p in locks:
        try:
            os.unlink(p)
            say(f"删掉遗留的锁文件 {p}")
        except OSError:
            pass


def usage(top, parts=(), tick=None):
    """(bytes allocated under top, {part: bytes under it} for the directories of parts below top), counted as du
    does: st_blocks, symlinks not followed, a file with several links once. tick is called every 1000 entries."""
    seen, share, n = set(), dict.fromkeys(parts, 0), 0
    try:
        total = os.lstat(top).st_blocks * 512
    except OSError:
        return 0, share
    todo = [(top, None)]
    while todo:
        path, part = todo.pop()
        try:
            with os.scandir(path) as it:
                entries = list(it)
        except OSError:
            continue
        for e in entries:
            n += 1
            if tick and n % 1000 == 0:
                tick()
            try:
                st = e.stat(follow_symlinks=False)
            except OSError:
                continue
            sub = e.path if e.path in share else part
            if e.is_dir(follow_symlinks=False):
                todo.append((e.path, sub))
            elif st.st_nlink > 1:
                if (st.st_dev, st.st_ino) in seen:
                    continue
                seen.add((st.st_dev, st.st_ino))
            total += st.st_blocks * 512
            if sub:
                share[sub] += st.st_blocks * 512
    return total, share


def size_text(n):
    return f"{n / 2 ** 30:.1f} GiB" if n >= 2 ** 30 else f"{n / 2 ** 20:.1f} MiB"


def cap_slot(slotdir, project, say, after=False, tick=None):
    """Keeps the slot dir at or below SLOT_MAX: above it, whole .build directories of the slot's work trees go, least
    recently used first by the mtime of .build/.cf-env.json (written when a job starts in the tree; a tree without it
    is the oldest). Before a job its project's .build is not touched; after the job it goes last, so only when it
    alone keeps the slot above.
    Run directories (.cf) and the container's HOME (.home) count but stay."""
    when = "作业后" if after else "作业前"
    own = os.path.join(slotdir, project, ".build")
    try:
        names = sorted(os.listdir(slotdir))
    except OSError as e:
        return say(f"{when}量不了槽位目录：{e}")
    builds = {}
    for name in names:
        b = os.path.join(slotdir, name, ".build")
        if name.startswith(".") or b == own and not after or not os.path.isdir(b) or os.path.islink(b):
            continue
        try:
            builds[b] = os.stat(os.path.join(b, ".cf-env.json")).st_mtime
        except OSError:
            builds[b] = 0
    total, sizes = usage(slotdir, builds, tick)
    if total <= SLOT_MAX:
        return
    for b in sorted(builds, key=lambda b: (b == own, builds[b])):
        if total <= SLOT_MAX:
            break
        shutil.rmtree(b, ignore_errors=True)
        freed = sizes[b] - (usage(b)[0] if os.path.lexists(b) else 0)
        last = time.strftime("上次作业 %m-%d %H:%M", time.localtime(builds[b])) if builds[b] else "没有作业记录"
        say(f"{when}槽位目录 {size_text(total)}，超过上限 {size_text(SLOT_MAX)}：删掉 {os.path.basename(os.path.dirname(b))} 的 "
            f".build（{last}），腾出 {size_text(freed)}，剩 {size_text(total - freed)}")
        total -= freed
    if total > SLOT_MAX:
        say(f"警告：{when}槽位目录 {slotdir} 还有 {size_text(total)}，超过上限 {size_text(SLOT_MAX)}；能删的 .build 都删了"
            f"（{'' if after else f'{project} 的要给这个作业用，'}作业目录 .cf 和 .home 不删）")


# ---- the supervisor: runs in the slot (in the container when the slot has one) ------------------------

JOB_COALITION = None     # (macOS) the supervisor's own coalition, when launchd gave it one: the job's processes


def descendants():
    if DARWIN:
        return darwin_descendants()
    kids = collections.defaultdict(list)
    for d in os.listdir("/proc"):
        if d.isdigit():
            s = proc_stat(d)
            if s:
                kids[s[1]].append(int(d))
    out, todo = [], [os.getpid()]
    while todo:
        for k in kids.get(todo.pop(), []):
            out.append(k)
            todo.append(k)
    return out


def darwin_descendants():
    """The job's processes on macOS: every other process of the supervisor's coalition (JOB_COALITION), which no
    process leaves; and, as without a coalition of its own, its process tree and its process group."""
    me, procs = os.getpid(), {}
    for p in all_pids():
        b = bsd_info(p)
        if b:
            procs[p] = (b.ppid, b.pgid)
    out = set(coalition_pids(JOB_COALITION))
    if os.getpgrp() == me:
        out |= {p for p, (_, pgid) in procs.items() if pgid == me}
    kids = collections.defaultdict(list)
    for p, (ppid, _) in procs.items():
        kids[ppid].append(p)
    todo = [me]
    while todo:
        for k in kids.get(todo.pop(), []):
            if k not in out:
                out.add(k)
                todo.append(k)
    out.discard(me)
    return sorted(out)


def own_coalition(job, rundir, say):
    """(macOS) The supervisor's coalition when it is its job's launchd agent: launchd started it under the agent's
    label, and the coalition is not the one the agent was submitted from (agent.json). None otherwise (a supervisor
    started by hand shares its coalition with everything of that login: it must not end those)."""
    mine = coalition(os.getpid())
    outside = (jload(os.path.join(rundir, "agent.json")) or {}).get("outside")
    if job.get("agent") and os.environ.get("XPC_SERVICE_NAME") == job["agent"] and mine and outside and mine != outside:
        return mine
    say("监管进程不是作为这个作业的 launchd agent 起来的：只按进程树和进程组清理作业的进程")
    return None


def signal_tree(sig):
    for pid in descendants():
        try:
            os.kill(pid, sig)
        except (ProcessLookupError, PermissionError):
            pass


def sup_main(rundir, detach=False):
    job = jload(os.path.join(rundir, "job.json"))
    if detach:
        pid = os.fork()
        if pid:
            os.waitpid(pid, 0)
            return
    try:
        os.setsid()
    except OSError:
        pass
    if not DARWIN:
        ctypes.CDLL(None).prctl(36, 1, 0, 0, 0)      # PR_SET_CHILD_SUBREAPER: orphans of the job come to this process
    asked = []
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, lambda *_: asked.append(1))
    log = open(os.path.join(rundir, "log"), "ab", buffering=0)
    say = lambda text: log.write(f"[cf] {text}\n".encode())
    alive, cancel = os.path.join(rundir, "alive"), os.path.join(rundir, "cancel")
    argv = job["req"]["argv"]
    start = time.time()
    if DARWIN:
        global JOB_COALITION
        JOB_COALITION = own_coalition(job, rundir, say)
        jdump(os.path.join(rundir, "sup.json"), {"pid": os.getpid(), "start": start, "coalition": JOB_COALITION,
                                                 "ticks": proc_stat(os.getpid())[2]})
    else:
        jdump(os.path.join(rundir, "sup.json"), {"pid": os.getpid(), "start": start})
    open(alive, "w").close()
    try:
        child = subprocess.Popen(["bash", "-c", argv[0]] if len(argv) == 1 else argv, cwd=job["tree"], env=job["env"],
                                 stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
    except OSError as e:
        say(f"命令起不来：{e}")
        return write_exit(rundir, 127, "exit", str(e))
    code = [None]

    def reap():
        try:
            while True:
                pid, st = os.waitpid(-1, os.WNOHANG)
                if pid == 0:
                    return
                if pid == child.pid:
                    c = os.waitstatus_to_exitcode(st)
                    code[0] = c if c >= 0 else 128 - c
        except ChildProcessError:
            return

    cuts = []

    def cap():
        """Over LOG_MAX the log keeps its head and its latest part; the command appends to the same file."""
        size = os.fstat(log.fileno()).st_size
        if size <= LOG_MAX:
            return
        with open(log.name, "rb") as f:
            f.seek(size - (LOG_MAX - LOG_HEAD) // 4)
            tail = f.read()
        os.ftruncate(log.fileno(), LOG_HEAD)
        cuts.append(1)
        say(f"日志超过 {LOG_MAX / 2 ** 20:g} MB，这里截掉了 {(size - LOG_HEAD - len(tail)) >> 10} KB（第 {len(cuts)} 次）")
        log.write(tail[tail.find(b"\n") + 1:])

    reason, killing, touched = "exit", None, start
    while code[0] is None:
        time.sleep(0.5)
        reap()
        t = time.time()
        if t - touched >= TOUCH:
            os.utime(alive)
            touched = t
            cap()
        if killing is None:
            if asked or os.path.exists(cancel):
                reason, killing = "cancelled", t
                say("取消：结束作业的进程")
            elif t - start >= job["req"]["timeout"]:
                reason, killing = "timeout", t
                say(f"超时（{job['req']['timeout']} 秒）：结束作业的进程")
            if killing:
                signal_tree(signal.SIGTERM)
        elif t - killing > 10:
            signal_tree(signal.SIGKILL)
    # The command is over; whatever it left running goes too, so the slot is empty when the conclusion is written.
    t0 = time.time()
    signal_tree(signal.SIGTERM)
    while True:
        reap()
        left = descendants()
        if not left:
            break
        if time.time() - t0 > 30:
            say(f"结束不了的进程：{left}")
            break
        if time.time() - t0 > 5:
            signal_tree(signal.SIGKILL)
        time.sleep(0.2)
    # Still before exit.json, so the slot is not handed to the next job while its work trees are measured.
    cap_slot(job["dir"], job["req"]["project"], say, after=True, tick=lambda: os.utime(alive))
    cap()
    note = f"日志超过 {LOG_MAX / 2 ** 20:g} MB，中间截掉过 {len(cuts)} 次" if cuts else ""
    final = {"exit": code[0], "timeout": CODE_TIMEOUT, "cancelled": CODE_CANCEL}[reason]
    write_exit(rundir, final, reason, note)


# ---- the launcher: runs on the host, one per job, detached from the executor ---------------------------

# ---- the launcher: runs on the host, one per job, detached from whoever started it ---------------------

def job_main(rundir):
    try:
        fd = os.open(os.path.join(rundir, "launch.json"), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    except FileExistsError:
        return
    os.write(fd, json.dumps({"pid": os.getpid(), "ticks": proc_stat(os.getpid())[2]}).encode())
    os.close(fd)
    job = jload(os.path.join(rundir, "job.json"))
    try:
        launch(job, rundir)
    finally:
        release(job)


def launch(job, rundir):
    log = open(os.path.join(rundir, "log"), "ab", buffering=0)
    say = lambda text: log.write(f"[cf] {text}\n".encode())
    cancel = os.path.join(rundir, "cancel")

    def check():
        if os.path.exists(cancel):
            raise Cancelled()

    def run(cmd, cwd=None, timeout=1800, quiet=False):
        """A preparation step; it ends when the job is cancelled (SIGTERM first, so git removes its lock files)."""
        p = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE if quiet else log,
                             stderr=subprocess.STDOUT, env=git_env(bulk=True))
        t0 = time.time()
        while p.poll() is None:
            if os.path.exists(cancel) or time.time() - t0 > timeout:
                p.terminate()
                try:
                    p.wait(10)
                except subprocess.TimeoutExpired:
                    p.kill()
                    p.wait()
                check()
                raise JobError(f"{' '.join(cmd[:4])} …：{timeout} 秒没做完")
            time.sleep(0.3)
        return p.returncode

    def must(cmd, what, **kw):
        if run(cmd, **kw):
            raise JobError(what)

    try:
        prepare(job, say, run, must, check)
        check()
        cmd = launch_command(job, rundir, run, say)
    except Cancelled:
        say("取消：还没开始跑")
        return write_exit(rundir, CODE_CANCEL, "cancelled")
    except JobError as e:
        say(f"准备失败：{e}")
        return write_exit(rundir, CODE_ERROR, "error", str(e))
    except Exception:
        say("准备失败：\n" + traceback.format_exc())
        return write_exit(rundir, CODE_ERROR, "error", "executor 内部错误，见日志")
    p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
    exit_json, alive = os.path.join(rundir, "exit.json"), os.path.join(rundir, "alive")
    deadline = time.time() + job["req"]["timeout"] + OVERRUN
    while p.poll() is None:
        if time.time() > deadline and not fresh(alive) and not os.path.exists(exit_json):
            return overrun(job, rundir, p, say)
        time.sleep(1)
    rc = p.returncode
    waited = False
    while not os.path.exists(exit_json) and fresh(alive):
        if not waited:
            say(f"{'incus exec ' if job.get('container') else '监管进程'}返回了（rc={rc}），监管进程还在：接着等它的结论")
            waited = True
        time.sleep(2)
    if job.get("agent"):     # (macOS) what is left in the job's coalition, and its daemon
        agent_kill(job, rundir)
    if not os.path.exists(exit_json):
        say(f"监管进程没留下结论就退出了（rc={rc}）")
        write_exit(rundir, CODE_LOST, "lost", f"监管进程退出 rc={rc}")


def release(job):
    """The slot is free again: its busy file goes when it is still this job's."""
    busy = os.path.join(job["dir"], ".cf", "busy")
    try:
        if open(busy).read().strip() == job["id"]:
            os.unlink(busy)
    except OSError:
        pass


def overrun(job, rundir, p, say):
    """The supervisor has neither concluded nor moved, OVERRUN seconds past the job's timeout (stopped, or its
    container paused): what can be reached of the job goes, and the job is lost."""
    if job.get("agent"):
        agent_kill(job, rundir)
    elif not job.get("container"):
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except OSError:
            pass
    p.kill()
    p.wait()
    say(f"超时 {OVERRUN} 秒后监管进程既没给结论也没有动静：结束它")
    write_exit(rundir, CODE_LOST, "lost", f"超时 {OVERRUN} 秒后监管进程既没给结论也没有动静（被停住了，或容器被暂停）")


def sweep_tmpdir(path, say):
    """Files of earlier jobs in the work tree's TMPDIR untouched for TMPDIR_KEEP. It runs while the job is prepared,
    when the slot has no other job, so no running job's file is among them."""
    cutoff, n, emptied = time.time() - TMPDIR_KEEP, 0, set()
    for top, dirs, files in os.walk(path, topdown=False):
        for name in files + [d for d in dirs if os.path.islink(os.path.join(top, d))]:
            try:
                if os.lstat(os.path.join(top, name)).st_mtime < cutoff:
                    os.unlink(os.path.join(top, name))
                    n += 1
                    emptied.add(top)
            except OSError:
                pass
        for name in dirs:
            sub = os.path.join(top, name)
            try:
                if not os.path.islink(sub) and (sub in emptied or os.lstat(sub).st_mtime < cutoff):
                    os.rmdir(sub)
                    emptied.add(top)
            except OSError:
                pass
    if n:
        say(f"清掉 {path} 里 {n} 个 {TMPDIR_KEEP // 86400} 天没动过的文件")


def fresh(path):
    try:
        return time.time() - os.stat(path).st_mtime < ALIVE
    except OSError:
        return False


def ensure_mirror(mirror):
    if os.path.isdir(mirror):
        return
    os.makedirs(os.path.dirname(mirror), exist_ok=True)
    tmp = f"{mirror}.tmp{os.getpid()}"
    shutil.rmtree(tmp, ignore_errors=True)
    subprocess.run(["git", "init", "-q", "--bare", tmp], check=True)
    subprocess.run(["git", "-C", tmp, "config", "uploadpack.allowAnySHA1InWant", "true"], check=True)
    try:
        os.rename(tmp, mirror)
    except OSError:          # another job made it first
        shutil.rmtree(tmp, ignore_errors=True)


def prepare(job, say, run, must, check):
    """The work tree of (slot, project) at the job's commit: mirror <- GitHub (only what it lacks), tree <- mirror."""
    req, mirror, tree = job["req"], job["mirror"], job["tree"]
    sha, repo = req["commit"], req["repo"]
    has = lambda r: run(["git", "-C", r, "cat-file", "-e", sha + "^{commit}"], quiet=True) == 0
    ensure_mirror(mirror)
    with open(mirror + ".lock", "w") as lock:
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                check()
                time.sleep(1)
        clear_locks(mirror, mirror, say, check)
        if not has(mirror):
            say(f"从 {repo} 取 {sha[:12]}")
            run(["git", "-C", mirror, "fetch", "-q", "--no-tags", repo, sha])
            if not has(mirror):
                say(f"从 {repo} 取全部分支")
                must(["git", "-C", mirror, "fetch", "-q", "--no-tags", "--prune", repo, "+refs/heads/*:refs/gh/*"],
                     f"从 {repo} 取分支失败")
            if not has(mirror):
                raise JobError(f"{repo} 上取不到提交 {sha}（先推到 GitHub，或在有这个提交的仓库里用 flow run --here）")
        must(["git", "-C", mirror, "update-ref", f"refs/cf/slot/{job['slot']}", sha], "update-ref 失败")
        for ref in run_out(["git", "-C", mirror, "for-each-ref", "--format=%(refname)", "refs/cf/job/"]).split():
            run(["git", "-C", mirror, "update-ref", "-d", ref], quiet=True)     # flow's pushes, now kept by the slot ref
    check()
    if not os.path.isdir(os.path.join(tree, ".git")):
        say(f"建工作树 {tree}")
        tmp = f"{tree}.tmp{os.getpid()}"
        shutil.rmtree(tmp, ignore_errors=True)
        must(["git", "clone", "-q", "--no-checkout", mirror, tmp], "建工作树失败")
        os.rename(tmp, tree)
    clear_locks(tree, os.path.join(tree, ".git"), say, check)
    if not has(tree):
        # The tree's submodules are never fetched here (a project's provision supplies them, possibly as a
        # link at the submodule path); git >= 2.45.1 refuses to recurse into a path that is a symbolic link.
        must(["git", "-C", tree, "fetch", "-q", "--no-tags", "--no-recurse-submodules", mirror, sha],
             "工作树从镜像取提交失败")
    must(["git", "-C", tree, "-c", "advice.detachedHead=false", "checkout", "-q", "-f", "--detach", sha], "checkout 失败")
    must(["git", "-C", tree, "clean", "-fdq"], "git clean 失败")
    stamp_path = os.path.join(tree, ".build", ".cf-env.json")
    deps_path = os.path.join(tree, "deps.json")
    cur_env = {"deps": open(deps_path).read() if os.path.isfile(deps_path) else "",
               "cache": job["env"].get("CF_DEPS_CACHE", ""), "container": job.get("container") or ""}
    old_env = jload(stamp_path)
    if req.get("clean") or (old_env is not None and old_env != cur_env):
        say("清空 .build（--clean）" if req.get("clean") else "清空 .build（deps.json 或槽位环境变了）")
        shutil.rmtree(os.path.join(tree, ".build"), ignore_errors=True)
    else:
        for sub in ("accept", "synth", "release", "downstream"):
            shutil.rmtree(os.path.join(tree, ".build", sub), ignore_errors=True)
    os.makedirs(os.path.join(tree, ".build", "tmp"), exist_ok=True)
    jdump(stamp_path, cur_env)
    sweep_tmpdir(os.path.join(tree, ".build", "tmp"), say)
    cap_slot(job["dir"], req["project"], say, tick=check)
    say(f"{req['project']}@{sha[:12]} 在 {job['machine']}/{job['slot']}：{req['cmd']}")


def run_out(cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""


def launch_command(job, rundir, run, say):
    me = os.path.join(rundir, "executor")
    if job.get("agent"):
        return [sys.executable, me, "_agent", rundir]
    if not job.get("container"):
        return [sys.executable, me, "_sup", rundir]
    # In the container the job runs as the host user's uid and gid (the work directory is an id-shifted mount, so the
    # files it writes belong to the host user). The container gets a passwd entry for that uid once; when the host
    # user's name is taken there by another uid, the entry is named cf<uid>.
    inc, c, uid, gid, user = job["incus"], job["container"], job["uid"], job["gid"], job["env"]["USER"]
    home = job["env"]["HOME"]
    os.makedirs(home, exist_ok=True)
    add = (f"getent passwd {uid} >/dev/null && exit 0; "
           f"getent group {gid} >/dev/null || groupadd -g {gid} {user} || groupadd -g {gid} cf{gid}; "
           f"n={user}; getent passwd $n >/dev/null && n=cf{uid}; "
           f"useradd -u {uid} -g {gid} -M -d {shlex.quote(home)} -s /bin/bash $n; getent passwd {uid}")
    if run(wrap(inc, ["exec", c, "-T", "-n", "--", "sh", "-c", add]), timeout=60):
        raise JobError(f"容器 {c} 里没法给 uid {uid} 建用户（见日志）")
    return wrap(inc, ["exec", c, "--user", str(uid), "--group", str(gid), "--cwd", job["dir"], "-T", "-n",
                      "--env", f"HOME={home}", "--", "python3", me, "_sup", "--detach", rundir])


# ---- macOS: the supervisor as a launchd agent ----------------------------------------------------------

def agent_domain(job, rundir):
    return (jload(os.path.join(rundir, "agent.json")) or {}).get("domain") or "system"


def launchctl(domain, *args):
    """launchctl for a domain: the system domain only through sudo (mac-agents install allows bootstrap and bootout
    there, and the chown of the plist to root, without a password)."""
    return subprocess.run((["sudo", "-n"] if domain == "system" else []) + ["launchctl", *args],
                          capture_output=True, text=True)


def agent_remove(job, rundir):
    domain = agent_domain(job, rundir)
    launchctl(domain, "bootout", f"{domain}/{job['agent']}")


def agent_kill(job, rundir):
    """What `systemctl kill` does to a scope: SIGKILL to every process of the job's coalition (the supervisor wrote
    its id into sup.json), unless that is this process's own; then the agent is removed."""
    cid = (jload(os.path.join(rundir, "sup.json")) or {}).get("coalition")
    if cid and cid != coalition(os.getpid()):
        for _ in range(10):
            pids = coalition_pids(cid)
            if not pids:
                break
            for pid in pids:
                try:
                    os.kill(pid, signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    pass
            time.sleep(0.3)
    agent_remove(job, rundir)


def agent_main(rundir):
    """Runs the job's supervisor as the launchd agent cf.<id> and stays until it has concluded or is gone, as
    `systemd-run --scope` stays with its scope. Exit status 0 when there is a conclusion."""
    import plistlib
    job = jload(os.path.join(rundir, "job.json"))
    label, me = job["agent"], os.path.join(rundir, "executor")
    plist, out = os.path.join(rundir, label + ".plist"), os.path.join(rundir, "launch.log")
    pw = pwd.getpwuid(os.getuid())
    if os.path.exists(plist):                # an earlier launcher's, owned by root now
        os.unlink(plist)
    with open(plist, "wb") as f:
        # A daemon of the system domain run as this user: it needs no login at the Mac (gui/<uid> exists only with
        # one, and user/<uid> takes no new job without one). Interactive: launchd applies no background throttling
        # to the job. Its processes other than those of the supervisor's process group are ended by the supervisor
        # (launchd ends that group when the daemon exits). The supervisor's environment is launchd's, not this
        # process's: HOME and PATH for its git and ssh, and the tests' tuning, are handed on.
        plistlib.dump({"Label": label, "ProgramArguments": [sys.executable, me, "_sup", rundir], "RunAtLoad": True,
                       "UserName": pw.pw_name, "GroupName": grp.getgrgid(os.getgid()).gr_name,
                       "ProcessType": "Interactive", "WorkingDirectory": job["dir"], "StandardOutPath": out,
                       "StandardErrorPath": out,
                       "EnvironmentVariables": {"HOME": pw.pw_dir, "USER": pw.pw_name, "LOGNAME": pw.pw_name,
                                                **{k: os.environ[k] for k in ("PATH", "CF_POOL_TUNE")
                                                   if k in os.environ}}}, f)
    jdump(os.path.join(rundir, "agent.json"), {"domain": "system", "outside": coalition(os.getpid())})
    launchctl("system", "bootout", f"system/{label}")      # an earlier launcher's
    # launchd loads into the system domain only a plist owned by root
    r = subprocess.run(["sudo", "-n", "chown", "root:wheel", plist], capture_output=True, text=True)
    if not r.returncode:
        r = launchctl("system", "bootstrap", "system", plist)
    if r.returncode:
        write_exit(rundir, CODE_ERROR, "error", f"launchd 没接下监管进程：{(r.stderr or r.stdout).strip()[-300:]}")
        return 1
    exit_json, t0 = os.path.join(rundir, "exit.json"), time.time()
    while not os.path.exists(exit_json):
        sup = jload(os.path.join(rundir, "sup.json"))
        if sup:
            if not pid_alive(sup.get("pid", 0), sup.get("ticks")):
                break
        elif time.time() - t0 > SPAWN:
            write_exit(rundir, CODE_LOST, "lost", f"launchd 接下了监管进程，{SPAWN} 秒里它没有起来（见 launch.log）")
            break
        time.sleep(0.5)
    if os.path.exists(exit_json):
        agent_remove(job, rundir)
        return 0
    return 1                 # the launcher ends what is left of the job by its coalition (agent_kill)


def wrap(mode, args):
    """incus as this process can reach it: directly, or through sg (a login older than the group membership)."""
    return ["incus", *args] if mode == "direct" else ["sg", "incus-admin", "-c", shlex.join(["incus", *args])]


# ---- the commands flow calls over ssh ------------------------------------------------------------------

def load_conf(machine):
    conf = json.load(open(os.path.join(ROOT, "machines.json")))
    if machine not in conf["machines"]:
        die(f"machines.json 里没有机器 {machine}")
    return conf, conf["machines"][machine]


def die(text):
    raise SystemExit(f"executor: {text}")


def slot_dir(name, s):
    return os.path.expanduser(s.get("dir") or (f"~/{s['container']}" if s.get("container") else f"~/curryflow/slots/{name}"))


def incus_mode():
    try:
        if subprocess.run(["incus", "list", "--format", "csv", "-c", "n"], capture_output=True, timeout=30).returncode == 0:
            return "direct"
    except (OSError, subprocess.TimeoutExpired):
        pass
    return "sg"


def new_id():
    return time.strftime("%y%m%d-%H%M%S", time.gmtime()) + "-" + os.urandom(2).hex()[:3]


def running(rundir):
    """Whether the job of a run directory may still run: no conclusion, and its launcher or supervisor is there."""
    if os.path.exists(os.path.join(rundir, "exit.json")):
        return False
    launch = jload(os.path.join(rundir, "launch.json"))
    if launch is None:
        try:
            return time.time() - os.stat(os.path.join(rundir, "job.json")).st_mtime < SPAWN
        except OSError:
            return False
    return pid_alive(launch.get("pid", 0), launch.get("ticks")) or fresh(os.path.join(rundir, "alive"))


def take(slotdir, rid):
    """The slot's busy file for job rid; an error naming the job that has the slot."""
    busy = os.path.join(slotdir, ".cf", "busy")
    for _ in range(3):
        try:
            fd = os.open(busy, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
            os.write(fd, rid.encode())
            os.close(fd)
            return
        except FileExistsError:
            try:
                other = open(busy).read().strip()
            except OSError:
                continue
            if ID.fullmatch(other) and running(os.path.join(slotdir, ".cf", other)):
                die(f"槽位正在跑作业 {other}（flow attach / flow cancel）")
            try:
                os.unlink(busy)
            except OSError:
                pass
    die("槽位的 busy 文件拿不到")


def sweep(slotdir):
    """Run directories whose job ended more than KEEP ago."""
    for rundir in glob.glob(os.path.join(slotdir, ".cf", "*")):
        ex = jload(os.path.join(rundir, "exit.json"))
        if ID.fullmatch(os.path.basename(rundir)) and ex and time.time() - ex.get("end", 0) > KEEP:
            shutil.rmtree(rundir, ignore_errors=True)


def cmd_start(a):
    conf, m = load_conf(a.machine)
    req = json.load(sys.stdin)
    s = m.get("slots", {}).get(req.get("slot"))
    if not s:
        die(f"{a.machine} 上没有槽位 {req.get('slot')}（有 {'、'.join(m.get('slots', {}))}）")
    if not (isinstance(req.get("commit"), str) and SHA.fullmatch(req["commit"])):
        die("commit 不是 40 位的提交")
    argv = req.get("argv")
    if not (isinstance(argv, list) and argv and all(isinstance(x, str) for x in argv)):
        die("argv 不是非空的字符串列表")
    if not (isinstance(req.get("timeout"), int) and 0 < req["timeout"] <= TIMEOUT_MAX):
        die(f"timeout 要在 1 到 {TIMEOUT_MAX} 秒之间")
    slot, slotdir, project = req["slot"], slot_dir(req["slot"], s), req["project"]
    os.makedirs(os.path.join(slotdir, ".cf"), exist_ok=True)
    sweep(slotdir)
    rid = new_id()
    take(slotdir, rid)
    try:
        rundir = os.path.join(slotdir, ".cf", rid)
        tree = os.path.join(slotdir, project)
        user = pwd.getpwuid(os.getuid()).pw_name
        home = os.path.join(slotdir, ".home") if s.get("container") else os.path.expanduser("~")
        env = {"HOME": home, "USER": user, "LOGNAME": user, "SHELL": "/bin/bash", "LANG": "C.UTF-8", "PATH": PATH,
               "PYTHONDONTWRITEBYTECODE": "1", "TMPDIR": os.path.join(tree, ".build", "tmp"),
               "CF_JOB": rid, "CF_MACHINE": a.machine, "CF_SLOT": slot, "CF_CPUS": s["cpus"],
               "CF_THREADS": str(len(cpu_list(s["cpus"]))), "CF_PROJECT": project, "CF_COMMIT": req["commit"]}
        if s.get("mem"):
            env["CF_MEM_GB"] = str(mem_bytes(s["mem"]) // 2 ** 30)
        if m.get("deps_cache"):
            env["CF_DEPS_CACHE"] = os.path.expanduser(m["deps_cache"])
        try:
            token = open(TOKEN).read().strip()
        except OSError:
            token = ""
        if token:             # what provision fetches from GitHub, where the job runs (no ssh key in a container)
            env.update({"GH_TOKEN": token, "GIT_CONFIG_COUNT": "2",
                        "GIT_CONFIG_KEY_0": f"url.https://x-access-token:{token}@github.com/.insteadOf",
                        "GIT_CONFIG_VALUE_0": "git@github.com:",
                        "GIT_CONFIG_KEY_1": f"url.https://x-access-token:{token}@github.com/.insteadOf",
                        "GIT_CONFIG_VALUE_1": "ssh://git@github.com/"})
        env.update({k: str(v).replace("~/", os.path.expanduser("~/")) for k, v in m.get("env", {}).items()})
        job = {"id": rid, "machine": a.machine, "slot": slot, "cpus": s["cpus"], "container": s.get("container"),
               "dir": slotdir, "tree": tree, "rundir": rundir, "start": int(time.time()), "env": env,
               "uid": os.getuid(), "gid": os.getgid(), "mirror": os.path.join(BASE, "mirror", project + ".git"),
               "req": {k: req.get(k) for k in ("project", "commit", "repo", "argv", "timeout", "clean", "who")}}
        job["req"]["cmd"] = argv[0] if len(argv) == 1 else shlex.join(argv)
        if s.get("container"):
            job["incus"] = incus_mode()
        elif DARWIN:
            job["agent"] = "cf." + rid       # the supervisor's launchd daemon: its coalition is the job's processes
        os.makedirs(rundir)
        old = os.umask(0o077)                # job.json carries the token
        try:
            jdump(os.path.join(rundir, "job.json"), job)
        finally:
            os.umask(old)
        shutil.copy(os.path.abspath(__file__), os.path.join(rundir, "executor"))
        subprocess.Popen([sys.executable, os.path.join(rundir, "executor"), "_job", rundir], cwd=slotdir,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except BaseException:
        release({"id": rid, "dir": slotdir})
        raise
    print(json.dumps({"id": rid, "rundir": rundir}))


def find(m, rid):
    for name, s in m.get("slots", {}).items():
        rundir = os.path.join(slot_dir(name, s), ".cf", rid)
        if os.path.isfile(os.path.join(rundir, "job.json")):
            return rundir
    die(f"这台机器上没有作业 {rid}")


def summary(rundir, n=40):
    job, ex = jload(os.path.join(rundir, "job.json")) or {}, jload(os.path.join(rundir, "exit.json"))
    req = job.get("req", {})
    d = {"id": job.get("id"), "machine": job.get("machine"), "slot": job.get("slot"), "project": req.get("project"),
         "commit": req.get("commit"), "cmd": req.get("cmd"), "who": req.get("who"), "start": job.get("start"),
         "log": os.path.join(rundir, "log")}
    tail = tail_lines(d["log"], n)
    d["last"] = next((x for x in reversed(tail) if x.strip()), "")
    if ex:
        d.update(code=ex["code"], reason=ex["reason"], note=ex.get("note", ""), end=int(ex["end"]),
                 secs=int(ex["end"] - job.get("start", ex["end"])), tail=tail)
    else:
        d["running"] = running(rundir)
    return d


def alerts(machine):
    return (jload(os.path.join(BASE, "exec", machine, "alerts.json")) or {}).get("alerts") or []


def cmd_wait(a):
    conf, m = load_conf(a.machine)
    rundir = find(m, a.id)
    exit_json, seen = os.path.join(rundir, "exit.json"), set()
    while not os.path.exists(exit_json):
        for al in alerts(a.machine):
            key = (al.get("what"), al.get("since"))
            if key not in seen:
                seen.add(key)
                print("CF-ALERT " + json.dumps(al, ensure_ascii=False), flush=True)
        if not running(rundir):
            write_exit(rundir, CODE_LOST, "lost", "启动进程和监管进程都不在了，也没有结论")
            break
        time.sleep(WAIT_STEP)
    print("CF-END " + json.dumps(summary(rundir), ensure_ascii=False), flush=True)


def cmd_cancel(a):
    conf, m = load_conf(a.machine)
    rundir = find(m, a.id)
    if not os.path.exists(os.path.join(rundir, "exit.json")):
        open(os.path.join(rundir, "cancel"), "w").close()
        t0 = time.time()
        while not os.path.exists(os.path.join(rundir, "exit.json")) and time.time() - t0 < 150:
            if not running(rundir):
                write_exit(rundir, CODE_CANCEL, "cancelled", "取消时启动进程和监管进程都已不在")
            time.sleep(1)
    print("CF-END " + json.dumps(summary(rundir), ensure_ascii=False), flush=True)


def cmd_ls(a):
    conf, m = load_conf(a.machine)
    out = []
    for name, s in m.get("slots", {}).items():
        for rundir in glob.glob(os.path.join(slot_dir(name, s), ".cf", "*")):
            if ID.fullmatch(os.path.basename(rundir)) and os.path.isfile(os.path.join(rundir, "job.json")):
                d = summary(rundir, 5)
                d.pop("tail", None)
                out.append(d)
    out.sort(key=lambda d: d["id"] or "", reverse=True)
    print(json.dumps({"machine": a.machine, "jobs": out, "alerts": alerts(a.machine)}, ensure_ascii=False))


def cmd_log(a):
    conf, m = load_conf(a.machine)
    for line in tail_lines(os.path.join(find(m, a.id), "log"), a.n, cap=max(65536, a.n * 400)):
        print(line)


def cmd_mirror(a):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", a.project):
        die(f"项目名不对：{a.project!r}")
    mirror = os.path.join(BASE, "mirror", a.project + ".git")
    ensure_mirror(mirror)
    print(mirror)


def main():
    if len(sys.argv) == 3 and sys.argv[1] in ("_job", "_sup", "_agent"):
        return {"_job": job_main, "_sup": sup_main, "_agent": agent_main}[sys.argv[1]](sys.argv[2])
    if len(sys.argv) == 4 and sys.argv[1] == "_sup" and sys.argv[2] == "--detach":
        return sup_main(sys.argv[3], detach=True)
    ap = argparse.ArgumentParser(prog="executor", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("start", "wait", "ls", "log", "cancel"):
        p = sub.add_parser(name)
        p.add_argument("--machine", required=True)
        if name in ("wait", "log", "cancel"):
            p.add_argument("id")
        if name == "log":
            p.add_argument("-n", type=int, default=40)
    sub.add_parser("mirror").add_argument("--project", required=True)
    a = ap.parse_args()
    return {"start": cmd_start, "wait": cmd_wait, "ls": cmd_ls, "log": cmd_log, "cancel": cmd_cancel,
            "mirror": cmd_mirror}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
