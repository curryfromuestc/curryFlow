#!/usr/bin/env python3
"""End-to-end test of the machine pool (templates/pool executor, flow, beat) on this machine.

usage: test/pool/e2e --work DIR [--pool DIR] [--only NAME,...] [--baseline]
       test/pool/e2e --work DIR --measure SECONDS [--pool DIR] [--baseline]

A local bare repository is the hub (machines.git), another one the project hub (demo). Two fake machines run an
executor each in a HOME of their own under DIR: t1 with bare slots a0 and a1, t2 with b0, on the last six CPUs of
this machine; a loop runs beat for each. The intervals of executor and flow are shortened through CF_POOL_TUNE.
Hooks of the two hubs and a git wrapper on PATH delay or refuse pushes, slow a fetch down, fail one machine's
reads of the hub and record what the preparation of a job saw (CPU affinity, ssh command, signals); marker files in
DIR/marks switch them on.

Every case sets up a situation, says what should happen and records what did. DIR/results.tsv has one row per case
(name, situation, expected, actual, PASS/FAIL); the last line of the output is RESULT. Exit 0 when every case passes.
--baseline runs an older executor and flow from --pool: it adds the line that reads CF_POOL_TUNE to them.
--measure counts, per fake machine, the hub operations of executor and beat in SECONDS with the real intervals:
first idle, then with one long job on each machine (DIR/ops.tsv).
"""
import argparse
import json
import os
import random
import shutil
import signal
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
REPO = os.path.dirname(os.path.dirname(HERE))
GIT = shutil.which("git")
PY = sys.executable
TUNE = {"TICK": 0.5, "POLL": 1.5, "POLL_MAX": 6, "SWEEP": 8, "REAP": 2, "LOST": 12, "RUN_GRACE": 2, "UNFIT": 6,
        "TOUCH": 1, "ALIVE": 6, "SPAWN": 5, "CANCEL_KILL": 10, "TMP_KEEP": 4, "LOG_MAX": 262144, "LOG_HEAD": 16384,
        "EXEC_LOG_MAX": 8192, "GIT_TIMEOUT": 5, "BUSY_MAX": 2, "WINDOW": 5, "MIN_WINDOW": 1, "BURST": 2, "QUIET": 0,
        "HEARTBEAT": 2, "HB_LOST": 15, "WAIT_STEP": 1, "HB_CHECK": 3}
INJECT = '    globals().update(json.loads(os.environ.get("CF_POOL_TUNE") or "{}"))\n'
ENV = {"GIT_AUTHOR_NAME": "e2e", "GIT_AUTHOR_EMAIL": "e2e@localhost", "GIT_COMMITTER_NAME": "e2e",
       "GIT_COMMITTER_EMAIL": "e2e@localhost"}


class Fail(Exception):
    pass


def sh(*cmd, cwd=None, env=None, input=None, check=True, timeout=120):
    r = subprocess.run(cmd, cwd=cwd, env=env, input=input, capture_output=True, text=True, timeout=timeout)
    if check and r.returncode:
        raise Fail(f"{' '.join(cmd)}: {r.returncode} {r.stderr.strip()[-300:]}")
    return r.stdout.strip()


def put(path, text, mode=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)
    if mode:
        os.chmod(path, mode)


def lines(path):
    try:
        with open(path) as f:
            return [x for x in f.read().splitlines() if x]
    except OSError:
        return []


def until(fn, secs, step=0.5):
    t = time.time() + secs
    while True:
        v = fn()
        if v or time.time() > t:
            return v
        time.sleep(step)


class Rig:
    def __init__(self, work, pool, baseline, tune):
        self.w, self.pool, self.baseline, self.tune = work, pool, baseline, tune
        self.marks = os.path.join(work, "marks")
        self.out = os.path.join(work, "out")
        self.procs = {}
        self.n = random.randrange(1 << 12)
        top = os.cpu_count()
        c = lambda i: f"{top - 6 + i}-{top - 5 + i}"
        self.cpus = {"a0": c(0), "a1": c(2), "b0": c(4)}
        self.homes = {m: os.path.join(work, "h" + m[1]) for m in ("t1", "t2")}

    # -- the rig --------------------------------------------------------------------------------------

    def clone(self, m):
        return os.path.join(self.homes[m], "curryflow", "machines")

    def slotdir(self, m, slot):
        return os.path.join(self.homes[m], "curryflow", "slots", slot)

    def rundir(self, rid):
        for m, slots in (("t1", ("a0", "a1")), ("t2", ("b0",))):
            for s in slots:
                d = os.path.join(self.slotdir(m, s), ".cf", rid)
                if os.path.isdir(d):
                    return d
        return None

    def env(self, m, **kw):
        e = {k: v for k, v in os.environ.items() if not k.startswith("CF_")}
        e.update(ENV, HOME=self.homes[m], PATH=os.path.join(self.w, "bin") + ":" + os.environ["PATH"],
                 CF_POOL_TUNE=json.dumps(self.tune), CF_WHO="e2e")
        e.update(kw)
        return e

    def hub(self, *args, input=None, check=True):
        return sh(GIT, "--git-dir", os.path.join(self.w, "hub.git"), *args, input=input, check=check)

    def proj(self, *args, check=True):
        return sh(GIT, "--git-dir", os.path.join(self.w, "proj.git"), *args, check=check)

    def setup(self):
        shutil.rmtree(self.w, ignore_errors=True)
        for d in (self.marks, self.out, os.path.join(self.w, "bin")):
            os.makedirs(d)
        w, mk = self.w, self.marks
        put(f"{w}/bin/git", f"""#!/bin/sh
case " $* " in *" {w}/proj.git"*|*"{w}/proj.git "*)
  case " $* " in *" fetch "*)
    if [ -e {mk}/cpus ]; then grep Cpus_allowed_list /proc/$$/status > {mk}/fetch.cpus; printf '%s\\n' "$GIT_SSH_COMMAND" > {mk}/fetch.ssh; fi
    if [ -e {mk}/slowfetch ]; then
      rm -f {mk}/slowfetch; echo $$ > {mk}/fetch.pid
      trap 'echo TERM >> {mk}/fetch.sig; kill $! 2>/dev/null; exit 143' TERM
      sleep 40 & wait; exit 1
    fi;;
  esac;;
esac
exec {GIT} "$@"
""", 0o755)
        for m in ("t1", "t2"):
            put(f"{w}/bin/up-{m}", f"""#!/bin/sh
echo "$(date +%s.%N) {m} read" >> {w}/ops.log
[ -e {mk}/lsfail-{m} ] && {{ echo "e2e: no hub for {m}" >&2; exit 1; }}
exec {GIT} upload-pack "$@"
""", 0o755)
            put(f"{w}/bin/rp-{m}", f"""#!/bin/sh
echo "$(date +%s.%N) {m} push" >> {w}/ops.log
exec {GIT} receive-pack "$@"
""", 0o755)
        sh(GIT, "init", "-q", "-b", "main", "--bare", f"{w}/hub.git")
        sh(GIT, "--git-dir", f"{w}/hub.git", "config", "receive.keepAlive", "0")
        put(f"{w}/hub.git/hooks/pre-receive", f"""#!/bin/sh
while read old new ref; do
  if [ -e {mk}/delay-run ] && [ "$ref" = "refs/run/$(cat {mk}/delay-run)" ]; then
    rm -f {mk}/delay-run; [ -e {mk}/delay-lsfail ] && touch {mk}/lsfail-t1
    sleep $(cat {mk}/delay-secs); rm -f {mk}/lsfail-t1
  fi
  case "$ref" in refs/q/*)
    [ -e {mk}/reject-q ] && {{ echo "e2e: q refused" >&2; exit 1; }}
    [ -e {mk}/slow-q ] && {{ sleep 20; exit 1; }};;
  esac
done
exit 0
""", 0o755)
        put(f"{w}/hub.git/hooks/reference-transaction", f"""#!/bin/sh
[ "$1" = committed ] || exit 0
while read old new ref; do echo "$(date +%s.%N) $ref $new" >> {w}/reflog.txt; done
""", 0o755)
        sh(GIT, "init", "-q", "-b", "main", "--bare", f"{w}/proj.git")
        put(f"{w}/proj.git/hooks/pre-receive", f"""#!/bin/sh
while read old new ref; do
  case "$ref" in refs/cf/tmp/*) [ "$new" = 0000000000000000000000000000000000000000 ] && [ -e {mk}/keep-tmp ] && exit 1;; esac
done
exit 0
""", 0o755)
        pw = f"{w}/projwork"
        sh(GIT, "clone", "-q", f"{w}/proj.git", pw)
        put(f"{pw}/README", "demo\n")
        put(f"{pw}/.gitignore", ".build/\n")
        sh(GIT, "-C", pw, "add", "-A", env={**os.environ, **ENV})
        sh(GIT, "-C", pw, "commit", "-qm", "demo", env={**os.environ, **ENV})
        sh(GIT, "-C", pw, "push", "-q", "origin", "HEAD:refs/heads/main")
        self.main = sh(GIT, "-C", pw, "rev-parse", "HEAD")
        conf = {"hub": f"{w}/hub.git", "projects": {"demo": {"hub": f"{w}/proj.git"}}, "machines": {
            "t1": {"executor": True, "shared": False, "slots": {"a0": {"cpus": self.cpus["a0"], "mem": "4GiB"},
                                                                "a1": {"cpus": self.cpus["a1"], "mem": "4GiB"}}},
            "t2": {"executor": True, "shared": False, "slots": {"b0": {"cpus": self.cpus["b0"], "mem": "4GiB"}}}}}
        seed = f"{w}/seed"
        sh(GIT, "clone", "-q", f"{w}/hub.git", seed)
        put(f"{seed}/machines.json", json.dumps(conf, indent=1))
        for name in ("executor", "flow", "beat", "status"):
            with open(os.path.join(self.pool, name)) as f:
                text = f.read()
            if self.baseline and name in ("executor", "flow") and INJECT not in text:
                text = text.replace("def main():\n", "def main():\n" + INJECT, 1)
            put(f"{seed}/{name}", text, 0o755)
        sh(GIT, "-C", seed, "add", "-A", env={**os.environ, **ENV})
        sh(GIT, "-C", seed, "commit", "-qm", "pool", env={**os.environ, **ENV})
        sh(GIT, "-C", seed, "push", "-q", "origin", "HEAD:refs/heads/main")
        for m in ("t1", "t2"):
            os.makedirs(self.homes[m])
            sh(GIT, "clone", "-q", f"{w}/hub.git", self.clone(m))
            sh(GIT, "-C", self.clone(m), "config", "remote.origin.uploadpack", f"{w}/bin/up-{m}")
            sh(GIT, "-C", self.clone(m), "config", "remote.origin.receivepack", f"{w}/bin/rp-{m}")

    def start(self, m):
        self.procs[m] = subprocess.Popen([PY, "executor", "run", "--machine", m], cwd=self.clone(m), env=self.env(m),
                                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def stop(self, m, sig=signal.SIGKILL):
        p = self.procs.pop(m, None)
        if p and p.poll() is None:
            p.send_signal(sig)
            p.wait()

    def beat_on(self, m, every=1):
        self.procs["beat-" + m] = subprocess.Popen(
            ["sh", "-c", f"while :; do {PY} beat --machine {m}; sleep {every}; done"], cwd=self.clone(m), env=self.env(m),
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    def beat_off(self, m):
        p = self.procs.pop("beat-" + m, None)
        if p and p.poll() is None:
            os.killpg(p.pid, signal.SIGKILL)
            p.wait()

    def shutdown(self):
        for name in list(self.procs):
            if name.startswith("beat-"):
                self.beat_off(name[5:])
            else:
                self.stop(name)

    def exec_log(self, m):
        return os.path.join(self.homes[m], "curryflow", "exec", m, "executor.log")

    def flow(self, *args, m="t1", cwd=None, timeout=180, **env):
        r = subprocess.run([PY, os.path.join(self.clone(m), "flow"), *args], cwd=cwd or self.w, env=self.env(m, **env),
                           capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()

    def flow_bg(self, *args, m="t1", cwd=None, **env):
        return subprocess.Popen([PY, os.path.join(self.clone(m), "flow"), *args], cwd=cwd or self.w, env=self.env(m, **env),
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)

    def submit(self, *args, **kw):
        rc, out = self.flow("run", "--project", "demo", "--no-wait", *args, **kw)
        if rc:
            raise Fail(f"flow run: {out[-300:]}")
        return out.splitlines()[-1].strip()

    def rid(self):
        self.n += 1
        return time.strftime("%y%m%d-%H%M%S", time.gmtime()) + f"-{self.n & 0xfff:03x}"

    def old_rid(self, days):
        self.n += 1
        return time.strftime("%y%m%d-%H%M%S", time.gmtime(time.time() - days * 86400)) + f"-{self.n & 0xfff:03x}"

    def job(self, rid, cmd, **kw):
        req = {"id": rid, "kind": "job", "submitted": round(time.time(), 3), "who": "e2e", "project": "demo",
               "commit": self.main, "argv": [cmd], "cmd": cmd, "need": {}, "prio": "normal", "timeout": 120}
        req.update(kw)
        return req

    def queue(self, rid, req):
        text = req if isinstance(req, str) else json.dumps(req)
        self.hub("update-ref", f"refs/q/{rid}", self.hub("hash-object", "-w", "--stdin", input=text))

    def refs(self, kind):
        out = {}
        for line in self.hub("for-each-ref", "--format=%(objectname) %(refname)", f"refs/{kind}/").splitlines():
            sha, ref = line.split()
            out[ref.split("/", 2)[2]] = sha
        return out

    def blob(self, sha):
        return json.loads(self.hub("cat-file", "blob", sha))

    def done(self, rid, secs=60):
        sha = until(lambda: self.refs("done").get(rid), secs)
        return self.blob(sha) if sha else None

    def commit(self, branch, push=True):
        pw = f"{self.w}/projwork"
        e = {**os.environ, **ENV}
        sh(GIT, "-C", pw, "checkout", "-q", "--detach", self.main, env=e)
        put(f"{pw}/{branch}.txt", f"{branch} {time.time()}\n")
        sh(GIT, "-C", pw, "add", "-A", env=e)
        sh(GIT, "-C", pw, "commit", "-qm", branch, env=e)
        sha = sh(GIT, "-C", pw, "rev-parse", "HEAD")
        if push:
            sh(GIT, "-C", pw, "push", "-q", "-f", "origin", f"HEAD:refs/heads/{branch}")
        return sha

    def mark(self, name, text=""):
        put(os.path.join(self.marks, name), text)

    def unmark(self, *names):
        for n in names:
            try:
                os.unlink(os.path.join(self.marks, n))
            except FileNotFoundError:
                pass

    def quiesce(self):
        for rid in self.refs("q"):
            self.hub("update-ref", "-d", f"refs/q/{rid}")
        until(lambda: not self.refs("run"), 40)
        for kind in ("run", "cancel"):
            for rid in self.refs(kind):
                self.hub("update-ref", "-d", f"refs/{kind}/{rid}")
        for m in ("t1", "t2"):
            st = os.path.join(self.homes[m], "curryflow", "exec", m, "state.json")
            until(lambda: all(s.get("state") in ("free", "warming") for s in
                              (json.load(open(st)) if os.path.exists(st) else {"slots": {}})["slots"].values()), 20)
        for n in os.listdir(self.marks):
            self.unmark(n)

    def tracebacks(self):
        n = 0
        for m in ("t1", "t2"):
            for p in (self.exec_log(m), self.exec_log(m) + ".1"):
                n += sum("Traceback" in x for x in lines(p))
        return n


def pid_gone(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            return f.read().rsplit(")", 1)[1].split()[0] == "Z"
    except OSError:
        return True


def interval(d):
    return d["start"], d["end"]


# ---- the cases ---------------------------------------------------------------------------------------

CASES = []


def case(name, situation, expected):
    def reg(fn):
        CASES.append((name, situation, expected, fn))
        return fn
    return reg


@case("A-claim", "两台机器的 executor 都在，连续提交 6 个短作业", "每个作业恰好跑一次，6 个结论都是 0")
def c_claim(r):
    log = f"{r.out}/A.log"
    ids = [r.submit("--", f"echo $CF_JOB >> {log}; sleep 1") for _ in range(6)]
    ds = [r.done(i, 90) for i in ids]
    runs = lines(log)
    counts = [runs.count(i) for i in ids]
    codes = [d and d["code"] for d in ds]
    where = sorted({f"{d['machine']}/{d['slot']}" for d in ds if d})
    return f"每个作业跑的次数 {counts}，退出码 {codes}，用到的槽位 {where}", counts == [1] * 6 and codes == [0] * 6


@case("B-restart", "作业在 t1 上跑着时 kill -9 t1 的 executor，再拉起", "作业不重跑，结论 0 照常报上去")
def c_restart(r):
    log = f"{r.out}/B.log"
    rid = r.submit("--machine", "t1", "--", f"echo x >> {log}; sleep 6")
    until(lambda: lines(log), 30)
    r.stop("t1")
    time.sleep(1)
    r.start("t1")
    d = r.done(rid, 60)
    return f"跑了 {len(lines(log))} 次，结论 {d and (d['reason'], d['code'])}", len(lines(log)) == 1 and d and d["code"] == 0


@case("B-window", "executor 起了启动进程、还没写下启动记录就被 kill -9（按各版本自己写在 Popen 之后的文件构造），再拉起",
      "不再起第二个启动进程：作业只跑一次，结论 0")
def c_window(r):
    log = f"{r.out}/B8.log"
    rid = r.submit("--machine", "t1", "--slot", "a0", "--", f"echo x >> {log}; sleep 4")
    until(lambda: lines(log), 30)
    r.stop("t1")
    rd = r.rundir(rid)
    if rd and not os.path.exists(os.path.join(rd, "spawn")):
        os.unlink(os.path.join(rd, "launch.json"))
    r.start("t1")
    d = r.done(rid, 60)
    time.sleep(3)
    return (f"跑了 {len(lines(log))} 次，结论 {d and (d['reason'], d['code'])}",
            len(lines(log)) == 1 and bool(d) and d["code"] == 0)


@case("C-leftover", "命令起了一个 setsid、忽略 SIGTERM 的后台进程后以 3 退出", "flow 退出码 3，后台进程被清掉")
def c_leftover(r):
    pf = f"{r.out}/C1.pid"
    rc, out = r.flow("run", "--project", "demo", "--machine", "t1", "--",
                     f"(setsid sh -c 'trap \"\" TERM; echo $$ > {pf}; exec sleep 300' &); sleep 1; exit 3")
    pid = (lines(pf) or ["0"])[0]
    gone = until(lambda: pid_gone(pid), 10)
    return f"flow 退出码 {rc}，后台进程 {pid} {'不在了' if gone else '还在'}", rc == 3 and gone


@case("C-cancel", "在跑的作业有一个 setsid nohup 起的孙进程，flow cancel", "结论 143（已取消），孙进程被清掉")
def c_cancel(r):
    pf = f"{r.out}/C2.pid"
    rid = r.submit("--machine", "t2", "--", f"setsid nohup sleep 300 >/dev/null 2>&1 & echo $! > {pf}; sleep 300")
    until(lambda: lines(pf), 30)
    rc, out = r.flow("cancel", rid)
    d = r.done(rid, 30)
    pid = lines(pf)[0]
    gone = until(lambda: pid_gone(pid), 10)
    return f"flow cancel 退出码 {rc}，结论 {d and (d['reason'], d['code'])}，孙进程{'不在了' if gone else '还在'}", (
        bool(d) and d["code"] == 143 and gone)


@case("C-timeout", "--timeout 3 的 sleep 60", "flow 退出码 124")
def c_timeout(r):
    rc, out = r.flow("run", "--project", "demo", "--timeout", "3", "--", "sleep 60")
    return f"flow 退出码 {rc}", rc == 124


@case("H-codes", "作业以 3 退出；提交一个中枢上没有的提交", "flow 分别以 3 和 99 退出")
def c_codes(r):
    rc1, _ = r.flow("run", "--project", "demo", "--", "exit 3")
    rc2, out = r.flow("run", "--project", "demo", "--commit", "%040x" % random.getrandbits(160), "--", "true")
    return f"退出码 {rc1}、{rc2}", rc1 == 3 and rc2 == 99


@case("H-lost", "作业在跑时它的启动进程和监管进程都被 kill -9（作业的进程也结束）", "结论 255（丢了），flow wait 以 255 退出")
def c_lost(r):
    pf = f"{r.out}/lost.pid"
    rid = r.submit("--machine", "t1", "--", f"echo $$ > {pf}; exec sleep 300")
    until(lambda: lines(pf), 30)
    rd = r.rundir(rid)
    until(lambda: os.path.exists(os.path.join(rd, "sup.json")) and os.path.exists(os.path.join(rd, "launch.json")), 10)
    for name in ("launch.json", "sup.json"):
        try:
            os.kill(json.load(open(os.path.join(rd, name)))["pid"], signal.SIGKILL)
        except (OSError, KeyError, ValueError):
            pass
    os.kill(int(lines(pf)[0]), signal.SIGKILL)
    rc, out = r.flow("wait", rid, timeout=120)
    return f"flow wait 退出码 {rc}：{out.splitlines()[-1] if out else ''}", rc == 255


@case("D-prio", "t2 唯一的槽位被占着时，依次提交 night、normal、gate 三个作业", "槽位空出来后按 gate、normal、night 的顺序跑")
def c_prio(r):
    log = f"{r.out}/D.log"
    first = r.submit("--machine", "t2", "--", "sleep 6")
    until(lambda: first in r.refs("run"), 30)
    ids = {p: r.submit("--machine", "t2", "--prio", p, "--", f"echo {p} >> {log}") for p in ("night", "normal", "gate")}
    for i in ids.values():
        r.done(i, 60)
    return f"顺序 {lines(log)}", lines(log) == ["gate", "normal", "night"]


@case("D-who", "槽位被占着时，X 提交两个、Y 提交一个（X 的先提交）", "按提交人轮转：X、Y、X")
def c_who(r):
    log = f"{r.out}/D2.log"
    first = r.submit("--machine", "t2", "--", "sleep 6")
    until(lambda: first in r.refs("run"), 30)
    ids = [r.submit("--machine", "t2", "--", f"echo {label} >> {log}", CF_WHO=w)
           for label, w in (("X1", "X"), ("X2", "X"), ("Y", "Y"))]
    for i in ids:
        r.done(i, 60)
    return f"顺序 {lines(log)}", lines(log) == ["X1", "Y", "X2"]


@case("D-hold", "flow hold 占住 t1/a1，再提交一个只要 a1 的作业，然后 flow release", "占用期间作业不跑；放了以后作业跑，结论 0")
def c_hold(r):
    rc, out = r.flow("hold", "--hours", "0.05", "--machine", "t1", "--slot", "a1", timeout=60)
    hid = next((x.split()[1] for x in out.splitlines() if x.startswith("占用 ")), None)
