@case("I-doc", "SKILL.md 的机器池一节", "写明会往项目中枢推 refs/cf/tmp/<id>、7 天按结束时间、容器里 HOME 的位置、hold 期间改工作树会被清掉")
def c_doc(r):
    with open(os.path.join(REPO, "SKILL.md")) as f:
        text = f.read()
    sec = text[text.index("## 机器池"):text.index("## curryPlan")]
    want = {"refs/cf/tmp": "refs/cf/tmp/" in sec, "结束": "结束 7 天" in sec or "结束后 7 天" in sec,
            "HOME": ".home" in sec, "hold": "checkout" in sec and "clean" in sec}
    return f"{want}", all(want.values()) and "不碰项目仓库的 ref" not in sec


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--work", required=True)
    ap.add_argument("--pool", default=os.path.join(REPO, "templates", "pool"))
    ap.add_argument("--only")
    ap.add_argument("--baseline", action="store_true")
    ap.add_argument("--measure", type=int)
    a = ap.parse_args()
    if a.measure:
        return measure(a)
    rig = Rig(os.path.abspath(a.work), os.path.abspath(a.pool), a.baseline, TUNE)
    rig.setup()
    for m in ("t1", "t2"):
        rig.start(m)
        rig.beat_on(m)
    rows = []
    only = set(a.only.split(",")) if a.only else None
    try:
        time.sleep(4)
        for name, situation, expected, fn in CASES:
            if only and name not in only:
                continue
            t = time.time()
            try:
                actual, ok = fn(rig)
            except Exception as e:
                actual, ok = f"出错：{type(e).__name__}: {e}", False
            row = [name, situation, expected, actual, "PASS" if ok else "FAIL"]
            rows.append(row)
            print(f"{row[4]} {name} ({int(time.time() - t)} s): {actual}", flush=True)
            try:
                rig.quiesce()
            except Exception as e:
                print(f"  quiesce: {e}", flush=True)
            for m in ("t1", "t2"):
                if m not in rig.procs:
                    rig.start(m)
                if "beat-" + m not in rig.procs:
                    rig.beat_on(m)
    finally:
        rig.shutdown()
    with open(os.path.join(rig.w, "results.tsv"), "w") as f:
        f.write("名称\t情形\t期望\t实际\t结论\n")
        for row in rows:
            f.write("\t".join(x.replace("\t", " ").replace("\n", " ") for x in row) + "\n")
    bad = [r[0] for r in rows if r[4] != "PASS"]
    print(f"{len(rows) - len(bad)}/{len(rows)} 通过；结果 {rig.w}/results.tsv")
    print(f"RESULT {'PASS' if not bad else 'FAIL'}: {', '.join(bad) or 'all cases'}")
    return 1 if bad else 0


def measure(a):
    tune = {"BUSY_MAX": 2, "MIN_WINDOW": 1, "QUIET": 0}
    rig = Rig(os.path.abspath(a.work), os.path.abspath(a.pool), a.baseline, tune)
    rig.setup()
    for m in ("t1", "t2"):
        rig.start(m)
        rig.beat_on(m, every=60)
    rows = []
    try:
        time.sleep(20)

        def window(label):
            t0 = time.time()
            time.sleep(a.measure)
            ops = [x.split() for x in lines(f"{rig.w}/ops.log") if t0 <= float(x.split()[0]) < t0 + a.measure]
            for m in ("t1", "t2"):
                for kind in ("read", "push"):
                    n = sum(1 for x in ops if x[1] == m and x[2] == kind)
                    rows.append([label, m, kind, n, round(n * 60 / a.measure, 2)])
        window("idle")
        ids = [rig.submit("--machine", m, "--", f"sleep {a.measure + 120}") for m in ("t1", "t2")]
        until(lambda: all(i in rig.refs("run") for i in ids), 60)
        time.sleep(10)
        window("2 jobs")
        for i in ids:
            rig.flow("cancel", "--no-wait", i)
        for i in ids:
            rig.done(i, 60)
    finally:
        rig.shutdown()
    with open(os.path.join(rig.w, "ops.tsv"), "w") as f:
        f.write("窗口\t机器\t操作\t次数\t每分钟\n")
        for row in rows:
            f.write("\t".join(map(str, row)) + "\n")
    for row in rows:
        print(*row)
    return 0


if __name__ == "__main__":
    sys.exit(main())
