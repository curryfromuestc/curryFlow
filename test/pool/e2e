    return f"区间 {a}-{b}、{c}-{e}；见过的槽位状态 {sorted(seen)}", b <= c and "claiming" in seen


@case("F-joblog", "作业往日志里写 2 MB（上限调成 256 KB）", "日志不超过上限，结论里注明截断，最后一行还在")
