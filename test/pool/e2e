@case("I-sweep", "两个 8 天前提交的请求的结论：一个刚刚才结束，一个 8 天前就结束了", "清理只删 8 天前结束的那个（按结束时间算 7 天）")
def c_sweep(r):
    ids = []
    for end in (time.time(), time.time() - 8 * 86400):
        rid = r.old_rid(8)
        d = {"id": rid, "kind": "job", "who": "e2e", "project": "demo", "cmd": "true", "prio": "normal", "machine": "t1",
             "slot": "a0", "start": int(end) - 5, "end": int(end), "secs": 5, "code": 0, "reason": "exit", "note": "",
             "last": "", "tail": [], "log": None}
        r.hub("update-ref", f"refs/done/{rid}", r.hub("hash-object", "-w", "--stdin", input=json.dumps(d)))
        ids.append(rid)
    until(lambda: ids[1] not in r.refs("done"), 40)
    time.sleep(r.tune["SWEEP"] + 2)
    have = r.refs("done")
    return f"刚结束的{'还在' if ids[0] in have else '被删了'}，8 天前结束的{'还在' if ids[1] in have else '删了'}", (
