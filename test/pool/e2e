@case("F-backoff", "t1 读不到中枢 20 秒（作业在这期间结束）", "轮询指数退避（20 秒里读中枢不超过 7 次）；中枢回来后结论照常报上去（0）")
def c_backoff(r):
    rid = r.submit("--machine", "t1", "--", "sleep 2")
    until(lambda: rid in r.refs("run"), 30)
    r.mark("lsfail-t1")
    t0 = time.time()
    time.sleep(20)
    r.unmark("lsfail-t1")
    n = sum(1 for x in lines(f"{r.w}/ops.log") if " t1 read" in x and t0 <= float(x.split()[0]) <= t0 + 20)
    d = r.done(rid, 60)
    return f"20 秒里读了 {n} 次，结论 {d and d['code']}", n <= 7 and bool(d) and d["code"] == 0


@case("F-hbpush", "一个跑 12 秒的作业", "refs/run/<id> 只在认领时写一次、结束时删一次，没有按作业的心跳 push")
def c_hbpush(r):
    rid = r.submit("--machine", "t2", "--", "sleep 12")
    d = r.done(rid, 60)
    n = sum(1 for x in lines(f"{r.w}/reflog.txt") if f" refs/run/{rid} " in x)
    return f"refs/run/{rid} 被更新 {n} 次，结论 {d and d['code']}", n <= 2 and bool(d) and d["code"] == 0


@case("I-sweep", "两个 8 天前提交的请求的结论：一个刚刚才结束，一个 8 天前就结束了", "清理只删 8 天前结束的那个（按结束时间算 7 天）")
def c_sweep(r):
    ids = []
    for end in (time.time(), time.time() - 8 * 86400):
        rid = r.old_rid(8)
        d = {"id": rid, "kind": "job", "who": "e2e", "project": "demo", "cmd": "true", "prio": "normal", "machine": "t1",
             "slot": "a0", "start": int(end) - 5, "end": int(end), "secs": 5, "code": 0, "reason": "exit", "note": "",
             "last": "", "tail": [], "log": None}
        r.hub("update-ref", f"refs/done/{rid}", r.hub("hash-object", "-w", "--stdin", input=json.dumps(d)))
        ids.append(rid)
    until(lambda: ids[1] not in r.refs("done"), 40)
    time.sleep(r.tune["SWEEP"] + 2)
    have = r.refs("done")
    return f"刚结束的{'还在' if ids[0] in have else '被删了'}，8 天前结束的{'还在' if ids[1] in have else '删了'}", (
        ids[0] in have and ids[1] not in have)


@case("J10-page", "机器页对 warming（测量中）和 claiming（认领中）的槽位", "不显示成空闲")
