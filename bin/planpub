#!/bin/bash
# 把一个页面目录发布到 curryplan：planpub 项目 页面名 目录 "标题" "一句话结论" [方案|笔记]
# 目录里要有 index.html；图片等放在同一目录。任何机器上都能用（走 ssh）。
set -e
[ $# -ge 5 ] || { sed -n 2,3p "$0"; exit 1; }
proj=$1 slug=$2 dir=$3 title=$4 say=$5 kind=${6:-方案}
host=user@old-plan.example
[ -f "$dir/index.html" ] || { echo "$dir/index.html 不存在"; exit 1; }
python3 -c 'import json,sys,datetime,socket; json.dump({"title":sys.argv[1],"say":sys.argv[2],"kind":sys.argv[3],"updated":datetime.datetime.now().strftime("%Y-%m-%d %H:%M"),"machine":socket.gethostname()},open(sys.argv[4],"w"),ensure_ascii=False)' "$title" "$say" "$kind" "$dir/meta.json"
ssh -o BatchMode=yes $host "mkdir -p /var/www/plan/$proj/$slug"
rsync -rlt --delete -e "ssh -o BatchMode=yes" "$dir/" "$host:/var/www/plan/$proj/$slug/"
ssh -o BatchMode=yes $host "python3 /var/www/plan/gen_catalog.py"
echo "https://plan.example:8443/$proj/$slug/"
